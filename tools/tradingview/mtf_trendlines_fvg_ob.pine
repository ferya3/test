//@version=5
indicator("MTF Trendlines + FVG/IFVG + OB", shorttitle="MTF TL·FVG·OB", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500, max_bars_back=1000)

// ════════════════════════════════════════════════════════════════
//  1) Multi-timeframe trendlines (1 / 5 / 10 / 15 / 30 / 60 / 240)
//  2) FVG + IFVG (inverse FVG)
//  3) Order Blocks (swing structure break based)
// ════════════════════════════════════════════════════════════════

// ───────────────────────── Inputs: Panel / Quick toggles ─────────────────────────
grpPN = "★ Control panel (all on/off switches)"
showTL    = input.bool(true, "Trendlines", group=grpPN)
showFVG   = input.bool(true, "FVG", group=grpPN)
showIFVG  = input.bool(true, "IFVG (inverse FVG)", group=grpPN)
showOB    = input.bool(true, "Order Blocks", group=grpPN)
showPanel = input.bool(true, "Show status panel", group=grpPN)
panelPos  = input.string("Top right", "Panel position", options=["Top left", "Top right", "Bottom left", "Bottom right"], group=grpPN)

// ───────────────────────── Inputs: Trendlines ─────────────────────────
grpTL = "Trendlines (multi-timeframe)"
tlPivot     = input.int(3, "Pivot length (on each timeframe)", minval=1, maxval=20, group=grpTL)
onlyValid   = input.bool(true, "Only valid lines (lower highs / higher lows)", group=grpTL)
showTLLabel = input.bool(true, "Show timeframe label", group=grpTL)
tlWidth     = input.int(1, "Line width", minval=1, maxval=4, group=grpTL)
tlStyleStr  = input.string("Solid", "Line style", options=["Solid", "Dashed", "Dotted"], group=grpTL)

on1  = input.bool(true, "1m",  inline="t1", group=grpPN)
c1   = input.color(#9E9E9E, "", inline="t1", group=grpPN)
on5  = input.bool(true, "5m",  inline="t1", group=grpPN)
c5   = input.color(#2196F3, "", inline="t1", group=grpPN)
on10 = input.bool(true, "10m", inline="t2", group=grpPN)
c10  = input.color(#00BCD4, "", inline="t2", group=grpPN)
on15 = input.bool(true, "15m", inline="t2", group=grpPN)
c15  = input.color(#4CAF50, "", inline="t2", group=grpPN)
on30 = input.bool(true, "30m", inline="t3", group=grpPN)
c30  = input.color(#FFC107, "", inline="t3", group=grpPN)
on60 = input.bool(true, "1H",  inline="t3", group=grpPN)
c60  = input.color(#FF9800, "", inline="t3", group=grpPN)
on240 = input.bool(true, "4H", inline="t4", group=grpPN)
c240  = input.color(#F44336, "", inline="t4", group=grpPN)

// ───────────────────────── Inputs: FVG / IFVG ─────────────────────────
grpFVG = "FVG / IFVG (chart timeframe)"
fvgMinATR  = input.float(0.1, "Min gap size (x ATR14)", minval=0.0, step=0.05, group=grpFVG)
maxFVG     = input.int(30, "Max active FVG/IFVG zones", minval=1, maxval=100, group=grpFVG)
keepMitig  = input.bool(false, "Keep mitigated zones (cut at mitigation bar)", group=grpFVG)
bullFvgCol  = input.color(color.new(#26A69A, 85), "Bullish FVG", inline="f1", group=grpFVG)
bearFvgCol  = input.color(color.new(#EF5350, 85), "Bearish FVG", inline="f1", group=grpFVG)
bullIfvgCol = input.color(color.new(#00E676, 75), "Bullish IFVG (support)", inline="f2", group=grpFVG)
bearIfvgCol = input.color(color.new(#FF1744, 75), "Bearish IFVG (resistance)", inline="f2", group=grpFVG)

// ───────────────────────── Inputs: Order Blocks ─────────────────────────
grpOB = "Order Blocks"
obSwing   = input.int(10, "Swing length", minval=2, maxval=50, group=grpOB)
maxOB     = input.int(15, "Max active order blocks", minval=1, maxval=100, group=grpOB)
keepOB    = input.bool(false, "Keep mitigated OBs (cut at mitigation bar)", group=grpOB)
bullObCol = input.color(color.new(#2962FF, 80), "Bullish OB", inline="o1", group=grpOB)
bearObCol = input.color(color.new(#FF6D00, 80), "Bearish OB", inline="o1", group=grpOB)

// ═══════════════════════════ Trendlines ═══════════════════════════

lineStyle = tlStyleStr == "Dashed" ? line.style_dashed : tlStyleStr == "Dotted" ? line.style_dotted : line.style_solid
chartSec  = timeframe.in_seconds(timeframe.period)

// A timeframe is only usable if it is >= the chart timeframe
f_ok(string tf) =>
    timeframe.in_seconds(tf) >= chartSec

// Last two confirmed pivot highs / lows, evaluated on the requested timeframe
f_piv(int len) =>
    ph = ta.pivothigh(high, len, len)
    pl = ta.pivotlow(low, len, len)
    var float h1 = na
    var int   h1t = na
    var float h2 = na
    var int   h2t = na
    var float l1 = na
    var int   l1t = na
    var float l2 = na
    var int   l2t = na
    if not na(ph)
        h2  := h1
        h2t := h1t
        h1  := ph
        h1t := time[len]
    if not na(pl)
        l2  := l1
        l2t := l1t
        l1  := pl
        l1t := time[len]
    [h1t, h1, h2t, h2, l1t, l1, l2t, l2]

[h1t_1,   h1_1,   h2t_1,   h2_1,   l1t_1,   l1_1,   l2t_1,   l2_1]   = request.security(syminfo.tickerid, "1",   f_piv(tlPivot))
[h1t_5,   h1_5,   h2t_5,   h2_5,   l1t_5,   l1_5,   l2t_5,   l2_5]   = request.security(syminfo.tickerid, "5",   f_piv(tlPivot))
[h1t_10,  h1_10,  h2t_10,  h2_10,  l1t_10,  l1_10,  l2t_10,  l2_10]  = request.security(syminfo.tickerid, "10",  f_piv(tlPivot))
[h1t_15,  h1_15,  h2t_15,  h2_15,  l1t_15,  l1_15,  l2t_15,  l2_15]  = request.security(syminfo.tickerid, "15",  f_piv(tlPivot))
[h1t_30,  h1_30,  h2t_30,  h2_30,  l1t_30,  l1_30,  l2t_30,  l2_30]  = request.security(syminfo.tickerid, "30",  f_piv(tlPivot))
[h1t_60,  h1_60,  h2t_60,  h2_60,  l1t_60,  l1_60,  l2t_60,  l2_60]  = request.security(syminfo.tickerid, "60",  f_piv(tlPivot))
[h1t_240, h1_240, h2t_240, h2_240, l1t_240, l1_240, l2t_240, l2_240] = request.security(syminfo.tickerid, "240", f_piv(tlPivot))

var line[]  tlLines  = array.new<line>()
var label[] tlLabels = array.new<label>()

// Draw one trendline through the previous (old) and latest (new) pivot
f_drawTL(bool enabled, string txt, color col, int tOld, float pOld, int tNew, float pNew, bool isResistance) =>
    if enabled and not na(tOld) and not na(tNew) and tNew > tOld
        bool valid = not onlyValid or (isResistance ? pNew < pOld : pNew > pOld)
        if valid
            line ln = line.new(tOld, pOld, tNew, pNew, xloc=xloc.bar_time, extend=extend.right, color=col, width=tlWidth, style=lineStyle)
            array.push(tlLines, ln)
            if showTLLabel
                float slope = (pNew - pOld) / (tNew - tOld)
                float py = pNew + slope * (time - tNew)
                label lb = label.new(time, py, txt, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(col, 80), textcolor=col, size=size.tiny)
                array.push(tlLabels, lb)

if barstate.islast
    for ln in tlLines
        line.delete(ln)
    array.clear(tlLines)
    for lb in tlLabels
        label.delete(lb)
    array.clear(tlLabels)
    if showTL
        f_drawTL(on1   and f_ok("1"),   "1m",  c1,   h2t_1,   h2_1,   h1t_1,   h1_1,   true)
        f_drawTL(on1   and f_ok("1"),   "1m",  c1,   l2t_1,   l2_1,   l1t_1,   l1_1,   false)
        f_drawTL(on5   and f_ok("5"),   "5m",  c5,   h2t_5,   h2_5,   h1t_5,   h1_5,   true)
        f_drawTL(on5   and f_ok("5"),   "5m",  c5,   l2t_5,   l2_5,   l1t_5,   l1_5,   false)
        f_drawTL(on10  and f_ok("10"),  "10m", c10,  h2t_10,  h2_10,  h1t_10,  h1_10,  true)
        f_drawTL(on10  and f_ok("10"),  "10m", c10,  l2t_10,  l2_10,  l1t_10,  l1_10,  false)
        f_drawTL(on15  and f_ok("15"),  "15m", c15,  h2t_15,  h2_15,  h1t_15,  h1_15,  true)
        f_drawTL(on15  and f_ok("15"),  "15m", c15,  l2t_15,  l2_15,  l1t_15,  l1_15,  false)
        f_drawTL(on30  and f_ok("30"),  "30m", c30,  h2t_30,  h2_30,  h1t_30,  h1_30,  true)
        f_drawTL(on30  and f_ok("30"),  "30m", c30,  l2t_30,  l2_30,  l1t_30,  l1_30,  false)
        f_drawTL(on60  and f_ok("60"),  "1H",  c60,  h2t_60,  h2_60,  h1t_60,  h1_60,  true)
        f_drawTL(on60  and f_ok("60"),  "1H",  c60,  l2t_60,  l2_60,  l1t_60,  l1_60,  false)
        f_drawTL(on240 and f_ok("240"), "4H",  c240, h2t_240, h2_240, h1t_240, h1_240, true)
        f_drawTL(on240 and f_ok("240"), "4H",  c240, l2t_240, l2_240, l1t_240, l1_240, false)

// ═══════════════════════════ FVG / IFVG ═══════════════════════════
// dir:  1 = bullish FVG,  -1 = bearish FVG
//       2 = bullish IFVG (former bearish FVG closed above -> support)
//      -2 = bearish IFVG (former bullish FVG closed below -> resistance)

atr14 = ta.atr(14)

var box[]   fzBox = array.new<box>()
var float[] fzTop = array.new<float>()
var float[] fzBot = array.new<float>()
var int[]   fzDir = array.new<int>()

f_addZone(int dir, int left, float top, float bot) =>
    color col = dir == 1 ? bullFvgCol : dir == -1 ? bearFvgCol : dir == 2 ? bullIfvgCol : bearIfvgCol
    string txt = math.abs(dir) == 1 ? "FVG" : "IFVG"
    box bx = box.new(left, top, bar_index + 1, bot, border_color=color.new(col, 40), bgcolor=col, extend=extend.right, text=txt, text_size=size.tiny, text_color=color.new(col, 20), text_halign=text.align_right)
    array.push(fzBox, bx)
    array.push(fzTop, top)
    array.push(fzBot, bot)
    array.push(fzDir, dir)

f_endBox(box bx, bool keep) =>
    if keep
        box.set_extend(bx, extend.none)
        box.set_right(bx, bar_index)
    else
        box.delete(bx)

bool newBullFvg  = false
bool newBearFvg  = false
bool newBullIfvg = false
bool newBearIfvg = false

if barstate.isconfirmed and (showFVG or showIFVG)
    // 1) update existing zones
    int i = array.size(fzBox) - 1
    while i >= 0
        int   d  = array.get(fzDir, i)
        float zt = array.get(fzTop, i)
        float zb = array.get(fzBot, i)
        box   bx = array.get(fzBox, i)
        bool  kill = false
        if d == 1 and close < zb
            kill := true
            if showIFVG
                f_addZone(-2, bar_index, zt, zb)
                newBearIfvg := true
        else if d == -1 and close > zt
            kill := true
            if showIFVG
                f_addZone(2, bar_index, zt, zb)
                newBullIfvg := true
        else if d == 2 and close < zb
            kill := true
        else if d == -2 and close > zt
            kill := true
        if kill
            f_endBox(bx, keepMitig)
            array.remove(fzBox, i)
            array.remove(fzTop, i)
            array.remove(fzBot, i)
            array.remove(fzDir, i)
        i -= 1

    // 2) detect new FVG (3-candle pattern)
    if showFVG and bar_index >= 2
        if low > high[2] and (low - high[2]) > atr14 * fvgMinATR
            f_addZone(1, bar_index - 2, low, high[2])
            newBullFvg := true
        if high < low[2] and (low[2] - high) > atr14 * fvgMinATR
            f_addZone(-1, bar_index - 2, low[2], high)
            newBearFvg := true

    // 3) cap the number of active zones
    while array.size(fzBox) > maxFVG
        box.delete(array.get(fzBox, 0))
        array.remove(fzBox, 0)
        array.remove(fzTop, 0)
        array.remove(fzBot, 0)
        array.remove(fzDir, 0)

// ═══════════════════════════ Order Blocks ═══════════════════════════
// Bullish OB: when price closes above the last swing high, the candle with the
// lowest low between that swing high and the break becomes a bullish OB.
// Bearish OB: mirror image with swing low / highest high.

var box[]   obBox = array.new<box>()
var float[] obTop = array.new<float>()
var float[] obBot = array.new<float>()
var int[]   obDir = array.new<int>()

var float hiY = na
var int   hiX = na
var bool  hiCrossed = true
var float loY = na
var int   loX = na
var bool  loCrossed = true

swH = ta.pivothigh(high, obSwing, obSwing)
swL = ta.pivotlow(low, obSwing, obSwing)

if not na(swH)
    hiY := swH
    hiX := bar_index - obSwing
    hiCrossed := false
if not na(swL)
    loY := swL
    loX := bar_index - obSwing
    loCrossed := false

bool newBullOB = false
bool newBearOB = false

if showOB and barstate.isconfirmed
    // 1) mitigation of existing OBs
    int j = array.size(obBox) - 1
    while j >= 0
        int   od = array.get(obDir, j)
        float ot = array.get(obTop, j)
        float ob = array.get(obBot, j)
        if (od == 1 and close < ob) or (od == -1 and close > ot)
            f_endBox(array.get(obBox, j), keepOB)
            array.remove(obBox, j)
            array.remove(obTop, j)
            array.remove(obBot, j)
            array.remove(obDir, j)
        j -= 1

    // 2) bullish structure break -> bullish OB
    if not hiCrossed and not na(hiY) and close > hiY
        hiCrossed := true
        int cnt = math.min(bar_index - hiX - 1, 500)
        if cnt >= 1
            float minL = low[1]
            int   off  = 1
            for k = 1 to cnt
                if low[k] < minL
                    minL := low[k]
                    off  := k
            float t = high[off]
            float b = low[off]
            box bx = box.new(bar_index - off, t, bar_index + 1, b, border_color=color.new(bullObCol, 30), bgcolor=bullObCol, extend=extend.right, text="OB", text_size=size.tiny, text_color=color.new(bullObCol, 10), text_halign=text.align_right)
            array.push(obBox, bx)
            array.push(obTop, t)
            array.push(obBot, b)
            array.push(obDir, 1)
            newBullOB := true

    // 3) bearish structure break -> bearish OB
    if not loCrossed and not na(loY) and close < loY
        loCrossed := true
        int cnt = math.min(bar_index - loX - 1, 500)
        if cnt >= 1
            float maxH = high[1]
            int   off  = 1
            for k = 1 to cnt
                if high[k] > maxH
                    maxH := high[k]
                    off  := k
            float t = high[off]
            float b = low[off]
            box bx = box.new(bar_index - off, t, bar_index + 1, b, border_color=color.new(bearObCol, 30), bgcolor=bearObCol, extend=extend.right, text="OB", text_size=size.tiny, text_color=color.new(bearObCol, 10), text_halign=text.align_right)
            array.push(obBox, bx)
            array.push(obTop, t)
            array.push(obBot, b)
            array.push(obDir, -1)
            newBearOB := true

    // 4) cap the number of active order blocks
    while array.size(obBox) > maxOB
        box.delete(array.get(obBox, 0))
        array.remove(obBox, 0)
        array.remove(obTop, 0)
        array.remove(obBot, 0)
        array.remove(obDir, 0)

// ═══════════════════════════ Alerts ═══════════════════════════
alertcondition(newBullFvg,  "Bullish FVG formed",  "Bullish FVG formed")
alertcondition(newBearFvg,  "Bearish FVG formed",  "Bearish FVG formed")
alertcondition(newBullIfvg, "Bullish IFVG formed", "Bullish IFVG (support) formed")
alertcondition(newBearIfvg, "Bearish IFVG formed", "Bearish IFVG (resistance) formed")
alertcondition(newBullOB,   "Bullish OB formed",   "Bullish Order Block formed")
alertcondition(newBearOB,   "Bearish OB formed",   "Bearish Order Block formed")

// ═══════════════════════════ Status panel ═══════════════════════════
// (Pine cannot draw clickable buttons. All switches live together in the first
//  group of the settings dialog; this panel mirrors their state on the chart.)

f_cnt(int[] arr, int a, int b) =>
    int n = 0
    int sz = array.size(arr)
    if sz > 0
        for idx = 0 to sz - 1
            int v = array.get(arr, idx)
            if v == a or v == b
                n += 1
    n

panelPosition = panelPos == "Top left" ? position.top_left : panelPos == "Bottom left" ? position.bottom_left : panelPos == "Bottom right" ? position.bottom_right : position.top_right

var table pn = table.new(panelPosition, 3, 12, bgcolor=color.new(#131722, 10), border_width=1, border_color=color.new(color.gray, 70))

f_tfRow(int row, string name, bool on, string tf, color col) =>
    string st = not showTL or not on ? "☐ OFF" : f_ok(tf) ? "☑ ON" : "⚠ N/A"
    color stCol = st == "☑ ON" ? color.lime : st == "⚠ N/A" ? color.orange : color.gray
    table.cell(pn, 0, row, "TL " + name, text_color=col, text_size=size.small, text_halign=text.align_left)
    table.cell(pn, 1, row, st, text_color=stCol, text_size=size.small)
    table.cell(pn, 2, row, st == "⚠ N/A" ? "< chart TF" : "", text_color=color.gray, text_size=size.tiny)

f_zoneRow(int row, string name, bool on, int n) =>
    table.cell(pn, 0, row, name, text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(pn, 1, row, on ? "☑ ON" : "☐ OFF", text_color=on ? color.lime : color.gray, text_size=size.small)
    table.cell(pn, 2, row, on ? str.tostring(n) + " active" : "", text_color=color.gray, text_size=size.tiny)

if barstate.islast
    if showPanel
        table.cell(pn, 0, 0, "CONTROL PANEL", text_color=color.white, text_size=size.small, text_halign=text.align_left)
        table.cell(pn, 1, 0, "", text_size=size.tiny)
        table.cell(pn, 2, 0, "", text_size=size.tiny)
        f_tfRow(1, "1m",  on1,   "1",   c1)
        f_tfRow(2, "5m",  on5,   "5",   c5)
        f_tfRow(3, "10m", on10,  "10",  c10)
        f_tfRow(4, "15m", on15,  "15",  c15)
        f_tfRow(5, "30m", on30,  "30",  c30)
        f_tfRow(6, "1H",  on60,  "60",  c60)
        f_tfRow(7, "4H",  on240, "240", c240)
        f_zoneRow(8,  "FVG",  showFVG,  f_cnt(fzDir, 1, -1))
        f_zoneRow(9,  "IFVG", showIFVG, f_cnt(fzDir, 2, -2))
        f_zoneRow(10, "OB",   showOB,   array.size(obDir))
        table.cell(pn, 0, 11, "⚙ Settings > Control panel to toggle", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
        table.cell(pn, 1, 11, "", text_size=size.tiny)
        table.cell(pn, 2, 11, "", text_size=size.tiny)
    else
        table.clear(pn, 0, 0, 2, 11)
