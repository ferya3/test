{
  "manifest_version": 3,
  "name": "Telegram ID Viewer",
  "version": "1.0.0",
  "description": "آیدی عددی چت‌ها و کاربران را در تلگرام وب نمایش می‌دهد.",
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/k/*",
        "https://web.telegram.org/a/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Telegram ID Viewer"
  }
}
