{
  "manifest_version": 3,
  "name": "Excel Group (Rubika & Eitaa)",
  "version": "1.1.0",
  "description": "ساخت گروه در روبیکا وب و ایتا وب از روی شماره‌های یک فایل اکسل",
  "action": {
    "default_title": "ساخت گروه از اکسل"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting", "activeTab"],
  "host_permissions": [
    "https://web.rubika.ir/*",
    "https://web.eitaa.com/*",
    "https://*.iranlms.ir/*"
  ]
}
