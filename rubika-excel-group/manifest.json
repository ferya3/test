{
  "manifest_version": 3,
  "name": "Rubika Excel Group",
  "version": "1.0.0",
  "description": "ساخت گروه در روبیکا وب از روی شماره‌های یک فایل اکسل",
  "action": {
    "default_title": "ساخت گروه روبیکا از اکسل"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting", "activeTab"],
  "host_permissions": [
    "https://web.rubika.ir/*",
    "https://*.iranlms.ir/*"
  ]
}
