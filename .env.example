# --- credentials (required) ---
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=-1001234567890

# --- model ---
FOREX_MODEL=claude-sonnet-5
FOREX_BATCH_SIZE=8

# --- storage ---
FOREX_DB=data/forex_agent.db
FOREX_DASHBOARD=data/dashboard.json

# --- ingestion ---
FOREX_LOOKBACK_MIN=90
FOREX_HTTP_TIMEOUT=15

# --- dedup ---
FOREX_DEDUP_HOURS=12
FOREX_DEDUP_SIM=0.72

# --- impact blending ---
FOREX_AI_WEIGHT=0.6
FOREX_HIST_WEIGHT=0.4
FOREX_MAX_IMPACT=8.0

# --- alerting thresholds ---
FOREX_INSTANT_IMPORTANCE=high
FOREX_INSTANT_CONFIDENCE=55
FOREX_INSTANT_IMPACT=0.35
FOREX_DIGEST_MAX=12
FOREX_COOLDOWN_MIN=45
FOREX_MAX_ALERTS_HR=12

# --- scheduling ---
FOREX_POLL_MIN=15

# --- behaviour ---
# FOREX_DRY_RUN=true prints to the terminal instead of sending to Telegram
FOREX_DRY_RUN=false
FOREX_LANG=fa
