DATABASE_URL="file:./dev.db"
# In production set this to the address users actually reach, e.g. https://escrowbridge.site
APP_URL="http://localhost:3000"
# 32-byte hex keys — regenerate for every environment with:  openssl rand -hex 32
SESSION_SECRET=""
CREDENTIAL_MASTER_KEY=""
# Watch-only wallet. WALLET_PROVIDER=mock derives deterministic demo addresses.
WALLET_PROVIDER="mock"
TRON_ACCOUNT_XPUB=""
TRONGRID_API_URL="https://api.trongrid.io"
TRONGRID_API_KEY=""
USDT_TRC20_CONTRACT="TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t"

# Timezone every displayed timestamp is rendered in. A server usually runs in
# UTC, which would show a deal delivered at 22:40 Tehran as 02:10 the next day.
NEXT_PUBLIC_DISPLAY_TIMEZONE="Asia/Tehran"

# Per-IP abuse limits (optional; defaults shown)
RATE_LIMIT_REGISTRATIONS_PER_HOUR="20"
RATE_LIMIT_LOGINS_PER_15MIN="10"

# Email. "console" prints messages to the server log; "smtp" sends for real.
MAIL_PROVIDER="console"
MAIL_FROM="EscrowBridge <no-reply@escrowbridge.local>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
