# Copy to .env.local for development. In production these live in
# /etc/artavil-web.env (written by deploy/install.sh).

# Public address — used for canonical URLs, the sitemap, and to decide whether
# the admin session cookie is Secure (it is whenever this starts with https://).
SITE_URL=http://localhost:3000

# SQLite database and uploaded images. Defaults: ./data/app.db and ./data/uploads
# DATABASE_PATH=/var/lib/artavil-web/app.db
# UPLOAD_DIR=/var/lib/artavil-web/uploads

# Used by `npm run db:seed` for the first administrator only.
# ADMIN_EMAIL=admin@artavilgold.ir
# ADMIN_PASSWORD=
