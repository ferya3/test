//@version=6
indicator("Order Blocks by Timeframe (5m…4H)", shorttitle = "OB TF", overlay = true, max_boxes_count = 500, max_bars_back = 500)

// =====================================================================================
//  اردربلاک‌های یک تایم‌فریم مشخص — هر تایم‌فریم جداگانه
//
//  از منوی Timeframe یکی از 5m / 10m / 15m / 30m / 45m / 1H / 4H را انتخاب کنید.
//  برای دیدن چند تایم‌فریم، اندیکاتور را چند بار به چارت اضافه کنید (هر بار یک تایم)
//  و با آیکون چشم هر کدام را جدا روشن/خاموش کنید.
//
//  فیلتر نویز به‌صورت خودکار بر اساس تایم‌فریم انتخابی تنظیم می‌شود:
//  هرچه تایم کوچک‌تر، شرط‌ها سخت‌گیرانه‌تر.
//    • Swing    : طول پیوت برای تشخیص سقف/کف ساختاری
//    • Disp×ATR : حداقل بدنه‌ی کندل ایمپالس نسبت به ATR
//    • Vol×     : حداقل حجم کندل ایمپالس نسبت به میانگین ۲۰ کندل (0 = خاموش)
//    • FVG      : الزام وجود Imbalance در حرکت ایمپالس
//    • MaxSize  : حداکثر ارتفاع زون نسبت به ATR
//
//  داده فقط از کندل بسته‌شده‌ی تایم انتخابی خوانده می‌شود (بدون ریپینت).
// =====================================================================================

int MAX_LOOKBACK = 150

// ───────────────────────────── Timeframe ─────────────────────────────
string G_TF = "Timeframe"
string tfSel = input.string("15m", "Order block timeframe", options = ["5m", "10m", "15m", "30m", "45m", "1H", "4H"], group = G_TF, tooltip = "اردربلاک‌های این تایم‌فریم نمایش داده می‌شود. برای تایم دیگر، اندیکاتور را دوباره به چارت اضافه کنید.")

// ───────────────────────────── General ─────────────────────────────
string G_GEN = "General"
string zoneType   = input.string("Wick", "Zone type", options = ["Wick", "Body"], group = G_GEN, tooltip = "Wick: کل کندل اردربلاک\nBody: فقط بدنه‌ی کندل")
string mitMode    = input.string("Close", "Mitigation by", options = ["Close", "Wick"], group = G_GEN, tooltip = "اردربلاک با بسته شدن کندل یا با سایه از سمت مقابل باطل شود")
bool   hideMit    = input.bool(true, "Hide mitigated OBs", group = G_GEN)
int    maxOBs     = input.int(5, "Max OBs per direction", minval = 1, maxval = 50, group = G_GEN)
bool   noOverlap  = input.bool(true, "Skip overlapping OBs", group = G_GEN)
bool   showTable  = input.bool(true, "Show info table", group = G_GEN)
bool   alertsOn   = input.bool(false, "Alert on new OB", group = G_GEN, tooltip = "در ساخت Alert گزینه‌ی Any alert() function call را انتخاب کنید")

// ───────────────────────────── Style ─────────────────────────────
string G_COL = "Style"
color bullCol = input.color(color.rgb(8, 153, 129), "Bull", group = G_COL, inline = "c")
color bearCol = input.color(color.rgb(242, 54, 69), "Bear", group = G_COL, inline = "c")
color mitCol  = input.color(color.gray, "Mitigated", group = G_COL, inline = "c")
color txtCol  = input.color(color.rgb(178, 181, 190), "Text", group = G_COL, inline = "c")
int   transp  = input.int(80, "Zone transparency", minval = 0, maxval = 100, group = G_COL)
int   bw      = input.int(1, "Border width", minval = 0, maxval = 4, group = G_COL)

// ───────────────────── Noise filter (preset per TF, optional override) ─────────────────────
string G_FLT = "Noise filter"
float strictMult = input.float(1.0, "Strictness ×", minval = 0.5, maxval = 3.0, step = 0.1, group = G_FLT, tooltip = "Disp و Vol در این عدد ضرب و MaxSize بر آن تقسیم می‌شود. 1 = پیش‌فرض")
bool  custom     = input.bool(false, "Override preset with values below", group = G_FLT, tooltip = "خاموش = تنظیمات خودکار بر اساس تایم‌فریم (پیشنهادی)")
int   cSw = input.int(8, "Swing", minval = 2, group = G_FLT, inline = "a")
float cDp = input.float(1.6, "Disp×ATR", minval = 0, step = 0.1, group = G_FLT, inline = "a")
float cVl = input.float(1.3, "Vol×", minval = 0, step = 0.1, group = G_FLT, inline = "b")
bool  cFv = input.bool(true, "FVG", group = G_FLT, inline = "b")
float cMx = input.float(2.0, "MaxSize×ATR", minval = 0.1, step = 0.1, group = G_FLT, inline = "b")

// TF → request string
string tfReq = switch tfSel
    "5m"  => "5"
    "10m" => "10"
    "15m" => "15"
    "30m" => "30"
    "45m" => "45"
    "1H"  => "60"
    => "240"

// presets: smaller TF = stricter
int pSw = switch tfSel
    "5m"  => 10
    "10m" => 9
    "15m" => 8
    "30m" => 7
    "45m" => 6
    "1H"  => 5
    => 4
float pDp = switch tfSel
    "5m"  => 2.0
    "10m" => 1.8
    "15m" => 1.6
    "30m" => 1.4
    "45m" => 1.3
    "1H"  => 1.2
    => 1.0
float pVl = switch tfSel
    "5m"  => 1.5
    "10m" => 1.4
    "15m" => 1.3
    "30m" => 1.2
    "45m" => 1.1
    "1H"  => 1.0
    => 0.0
bool pFv = tfSel == "5m" or tfSel == "10m" or tfSel == "15m"
float pMx = switch tfSel
    "5m"  => 1.5
    "10m" => 1.75
    "15m" => 2.0
    "30m" => 2.25
    "45m" => 2.5
    "1H"  => 2.75
    => 3.0

int   fSw = custom ? cSw : pSw
float fDp = (custom ? cDp : pDp) * strictMult
float fVl = (custom ? cVl : pVl) * strictMult
bool  fFv = custom ? cFv : pFv
float fMx = (custom ? cMx : pMx) / strictMult
bool  useBody = zoneType == "Body"

// =====================================================================================
//  Detection — runs inside request.security on the selected timeframe
// =====================================================================================
detectOB(int swingLen, float dispMult, float volMult, bool needFvg, float maxSizeAtr, bool body) =>
    float atr    = ta.atr(14)
    float volAvg = ta.sma(volume, 20)
    float ph     = ta.pivothigh(high, swingLen, swingLen)
    float pl     = ta.pivotlow(low, swingLen, swingLen)

    var float swHigh       = na
    var int   swHighBar    = na
    var bool  swHighBroken = true
    var float swLow        = na
    var int   swLowBar     = na
    var bool  swLowBroken  = true

    var float bullTop  = na
    var float bullBot  = na
    var int   bullTime = na
    var float bullId   = 0.0
    var float bearTop  = na
    var float bearBot  = na
    var int   bearTime = na
    var float bearId   = 0.0

    if not na(ph)
        swHigh       := ph
        swHighBar    := bar_index - swingLen
        swHighBroken := false
    if not na(pl)
        swLow       := pl
        swLowBar    := bar_index - swingLen
        swLowBroken := false

    // ── Bullish OB: close breaks above the last swing high (BOS up)
    if not swHighBroken and not na(swHigh) and close > swHigh
        swHighBroken := true
        int   window = math.max(1, math.min(bar_index - swHighBar, MAX_LOOKBACK))
        int   idx    = 1
        float minL   = low[1]
        for i = 1 to window
            if low[i] < minL
                minL := low[i]
                idx  := i
        int obIdx = idx
        if close[idx] >= open[idx]
            for j = idx + 1 to idx + 2
                if close[j] < open[j]
                    obIdx := j
                    break
        float top = body ? math.max(open[obIdx], close[obIdx]) : high[obIdx]
        float bot = body ? math.min(open[obIdx], close[obIdx]) : minL

        float maxBody = 0.0
        float maxVol  = 0.0
        for k = 0 to obIdx - 1
            maxBody := math.max(maxBody, close[k] - open[k])
            maxVol  := math.max(maxVol, nz(volume[k]))
        bool fvgOk = not needFvg
        if needFvg and obIdx >= 2
            for k = 0 to obIdx - 2
                if low[k] > high[k + 2]
                    fvgOk := true
                    break
        bool  dispOk = maxBody >= dispMult * atr
        bool  volOk  = volMult <= 0 or na(volAvg) or volAvg <= 0 or maxVol >= volMult * volAvg
        float zoneH  = top - bot
        bool  sizeOk = zoneH > 0 and zoneH <= maxSizeAtr * atr
        if dispOk and volOk and fvgOk and sizeOk
            bullTop  := top
            bullBot  := bot
            bullTime := time[obIdx]
            bullId   += 1

    // ── Bearish OB: close breaks below the last swing low (BOS down)
    if not swLowBroken and not na(swLow) and close < swLow
        swLowBroken := true
        int   window = math.max(1, math.min(bar_index - swLowBar, MAX_LOOKBACK))
        int   idx    = 1
        float maxH   = high[1]
        for i = 1 to window
            if high[i] > maxH
                maxH := high[i]
                idx  := i
        int obIdx = idx
        if close[idx] <= open[idx]
            for j = idx + 1 to idx + 2
                if close[j] > open[j]
                    obIdx := j
                    break
        float top = body ? math.max(open[obIdx], close[obIdx]) : maxH
        float bot = body ? math.min(open[obIdx], close[obIdx]) : low[obIdx]

        float maxBody = 0.0
        float maxVol  = 0.0
        for k = 0 to obIdx - 1
            maxBody := math.max(maxBody, open[k] - close[k])
            maxVol  := math.max(maxVol, nz(volume[k]))
        bool fvgOk = not needFvg
        if needFvg and obIdx >= 2
            for k = 0 to obIdx - 2
                if high[k] < low[k + 2]
                    fvgOk := true
                    break
        bool  dispOk = maxBody >= dispMult * atr
        bool  volOk  = volMult <= 0 or na(volAvg) or volAvg <= 0 or maxVol >= volMult * volAvg
        float zoneH  = top - bot
        bool  sizeOk = zoneH > 0 and zoneH <= maxSizeAtr * atr
        if dispOk and volOk and fvgOk and sizeOk
            bearTop  := top
            bearBot  := bot
            bearTime := time[obIdx]
            bearId   += 1

    // previous (closed) bar values + lookahead_on  →  no repaint
    [bullTop[1], bullBot[1], bullTime[1], bullId[1], bearTop[1], bearBot[1], bearTime[1], bearId[1]]

[bT, bB, bTm, bId, sT, sB, sTm, sId] = request.security(syminfo.tickerid, tfReq, detectOB(fSw, fDp, fVl, fFv, fMx, useBody), lookahead = barmerge.lookahead_on)

// اردربلاک تایم کوچک‌تر از تایم چارت قابل‌اعتماد نیست
bool tfValid = timeframe.in_seconds(tfReq) >= timeframe.in_seconds(timeframe.period)

// =====================================================================================
//  Drawing & mitigation
// =====================================================================================
type OB
    box   bx
    float top
    float bot
    bool  active

var array<OB> bulls = array.new<OB>()
var array<OB> bears = array.new<OB>()

hasOverlap(array<OB> arr, float top, float bot) =>
    bool res = false
    for ob in arr
        if ob.active and top >= ob.bot and bot <= ob.top
            res := true
            break
    res

addOB(array<OB> arr, float top, float bot, int t, bool bull) =>
    color base = bull ? bullCol : bearCol
    box bx = box.new(t, top, time, bot, xloc = xloc.bar_time, border_color = color.new(base, 25), border_width = bw, bgcolor = color.new(base, transp), text = tfSel + (bull ? " Bull OB" : " Bear OB"), text_size = size.tiny, text_color = txtCol, text_halign = text.align_right, text_valign = text.align_center)
    arr.unshift(OB.new(bx, top, bot, true))
    if arr.size() > maxOBs
        OB old = arr.pop()
        old.bx.delete()

updateOBs(array<OB> arr, bool bull) =>
    int n = arr.size()
    if n > 0
        for i = n - 1 to 0
            OB ob = arr.get(i)
            if ob.active
                float src    = mitMode == "Close" ? close : bull ? low : high
                bool  broken = bull ? src < ob.bot : src > ob.top
                if broken
                    ob.active := false
                    if hideMit
                        arr.remove(i)
                        ob.bx.delete()
                    else
                        ob.bx.set_right(time)
                        ob.bx.set_bgcolor(color.new(mitCol, 88))
                        ob.bx.set_border_color(color.new(mitCol, 60))
                else
                    ob.bx.set_right(time)

bool newBull = tfValid and not na(bId) and bId != nz(bId[1], -1.0) and not na(bT) and not na(bB) and not na(bTm)
bool newBear = tfValid and not na(sId) and sId != nz(sId[1], -1.0) and not na(sT) and not na(sB) and not na(sTm)

if newBull and not (noOverlap and hasOverlap(bulls, bT, bB))
    addOB(bulls, bT, bB, bTm, true)
    if alertsOn
        alert("New BULLISH order block (" + tfSel + ") | " + syminfo.ticker + " | " + str.tostring(bB, format.mintick) + " – " + str.tostring(bT, format.mintick), alert.freq_once_per_bar)

if newBear and not (noOverlap and hasOverlap(bears, sT, sB))
    addOB(bears, sT, sB, sTm, false)
    if alertsOn
        alert("New BEARISH order block (" + tfSel + ") | " + syminfo.ticker + " | " + str.tostring(sB, format.mintick) + " – " + str.tostring(sT, format.mintick), alert.freq_once_per_bar)

updateOBs(bulls, true)
updateOBs(bears, false)

// =====================================================================================
//  Info table
// =====================================================================================
var table infoT = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 75), frame_color = color.new(color.gray, 60), frame_width = 1, border_color = color.new(color.gray, 80), border_width = 1)

countActive(array<OB> arr) =>
    int c = 0
    for ob in arr
        if ob.active
            c += 1
    c

setRow(int row, string k, string v, color c) =>
    infoT.cell(0, row, k, text_color = txtCol, text_size = size.small, text_halign = text.align_left)
    infoT.cell(1, row, v, text_color = c, text_size = size.small)

if showTable and barstate.islast
    if not tfValid
        infoT.clear(0, 0, 1, 6)
        infoT.cell(0, 0, "OB " + tfSel + ": chart TF is higher — switch chart to " + tfSel + " or lower", text_color = bearCol, text_size = size.small)
    else
        setRow(0, "Timeframe", tfSel, txtCol)
        setRow(1, "Swing", str.tostring(fSw), txtCol)
        setRow(2, "Disp×ATR", str.tostring(fDp, "#.##"), txtCol)
        setRow(3, "Vol×", fVl > 0 ? str.tostring(fVl, "#.##") : "off", txtCol)
        setRow(4, "FVG", fFv ? "required" : "–", txtCol)
        setRow(5, "Active bull", str.tostring(countActive(bulls)), bullCol)
        setRow(6, "Active bear", str.tostring(countActive(bears)), bearCol)
