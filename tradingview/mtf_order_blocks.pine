// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0
//@version=6
indicator("MTF Order Blocks 5m→4H | Adaptive Noise Filter", shorttitle = "MTF OB", overlay = true, max_boxes_count = 500, max_bars_back = 500)

// =====================================================================================
//  اردربلاک‌های چند تایم‌فریمی: 5m / 10m / 15m / 30m / 45m / 1H / 4H
//
//  فیلتر نویز پلکانی: هرچه تایم‌فریم کوچک‌تر باشد، شرط‌ها سخت‌گیرانه‌تر است
//    • Swing    : طول پیوت برای تشخیص سقف/کف ساختاری (بزرگ‌تر = سقف/کف معتبرتر)
//    • Disp×ATR : حداقل بدنه‌ی کندل ایمپالس (جابه‌جایی) نسبت به ATR
//    • Vol×     : حداقل حجم کندل ایمپالس نسبت به میانگین حجم ۲۰ کندل (0 = خاموش)
//    • FVG      : الزام وجود گپ ارزش منصفانه (Imbalance) در حرکت ایمپالس
//    • MaxSize  : حداکثر ارتفاع اردربلاک نسبت به ATR (زون‌های خیلی پهن حذف می‌شوند)
//
//  اردربلاک صعودی  = آخرین کندل نزولی در کف حرکتی که سقف ساختاری قبلی را با کلوز شکسته (BOS)
//  اردربلاک نزولی  = آخرین کندل صعودی در سقف حرکتی که کف ساختاری قبلی را با کلوز شکسته
//  داده‌ی تایم‌فریم بالاتر فقط از کندل بسته‌شده خوانده می‌شود (بدون ریپینت).
// =====================================================================================

int MAX_LOOKBACK = 150

// ───────────────────────────── General ─────────────────────────────
string G_GEN = "General"
string zoneType   = input.string("Wick", "Zone type", options = ["Wick", "Body"], group = G_GEN, tooltip = "Wick: کل کندل اردربلاک (سایه تا سایه)\nBody: فقط بدنه‌ی کندل")
string mitMode    = input.string("Close", "Mitigation by", options = ["Close", "Wick"], group = G_GEN, tooltip = "اردربلاک چه زمانی باطل شود: با بسته شدن کندل یا با برخورد سایه به سمت دیگر زون")
bool   hideMit    = input.bool(true, "Hide mitigated OBs", group = G_GEN)
int    maxPerTF   = input.int(3, "Max OBs per TF / direction", minval = 1, maxval = 10, group = G_GEN)
float  strictMult = input.float(1.0, "Global strictness ×", minval = 0.5, maxval = 3.0, step = 0.1, group = G_GEN, tooltip = "ضریب کلی سخت‌گیری: Disp و Vol در این عدد ضرب و MaxSize بر آن تقسیم می‌شود. 1 = پیش‌فرض")
bool   noOverlap  = input.bool(true, "Skip overlapping OBs (same TF)", group = G_GEN)
bool   onlyHigher = input.bool(true, "Only TFs ≥ chart TF", group = G_GEN, tooltip = "اردربلاک تایم‌های کوچک‌تر از تایم چارت نمایش داده نمی‌شود (روی تایم بزرگ‌تر دقیق نیستند)")
bool   showTable  = input.bool(true, "Show info table", group = G_GEN)
bool   alertsOn   = input.bool(false, "Alert on new OB", group = G_GEN, tooltip = "بعد از فعال کردن، از منوی Alert گزینه‌ی Any alert() function call را انتخاب کنید")

// ───────────────────────────── Style ─────────────────────────────
string G_COL = "Style"
color bullCol = input.color(color.rgb(8, 153, 129), "Bull", group = G_COL, inline = "c")
color bearCol = input.color(color.rgb(242, 54, 69), "Bear", group = G_COL, inline = "c")
color mitCol  = input.color(color.gray, "Mitigated", group = G_COL, inline = "c")
color txtCol  = input.color(color.rgb(178, 181, 190), "Text", group = G_COL, inline = "c")

// ─────────────────── Per-timeframe noise filters (strict → loose) ───────────────────
string G5 = "5m  — strictest"
bool  on5 = input.bool(true, "Show", group = G5, inline = "a")
int   sw5 = input.int(10, "Swing", minval = 2, group = G5, inline = "a")
float dp5 = input.float(2.0, "Disp×ATR", minval = 0, step = 0.1, group = G5, inline = "a")
float vl5 = input.float(1.5, "Vol×", minval = 0, step = 0.1, group = G5, inline = "b")
bool  fv5 = input.bool(true, "FVG", group = G5, inline = "b")
float mx5 = input.float(1.5, "MaxSize×ATR", minval = 0.1, step = 0.1, group = G5, inline = "b")

string G10 = "10m"
bool  on10 = input.bool(true, "Show", group = G10, inline = "a")
int   sw10 = input.int(9, "Swing", minval = 2, group = G10, inline = "a")
float dp10 = input.float(1.8, "Disp×ATR", minval = 0, step = 0.1, group = G10, inline = "a")
float vl10 = input.float(1.4, "Vol×", minval = 0, step = 0.1, group = G10, inline = "b")
bool  fv10 = input.bool(true, "FVG", group = G10, inline = "b")
float mx10 = input.float(1.75, "MaxSize×ATR", minval = 0.1, step = 0.1, group = G10, inline = "b")

string G15 = "15m"
bool  on15 = input.bool(true, "Show", group = G15, inline = "a")
int   sw15 = input.int(8, "Swing", minval = 2, group = G15, inline = "a")
float dp15 = input.float(1.6, "Disp×ATR", minval = 0, step = 0.1, group = G15, inline = "a")
float vl15 = input.float(1.3, "Vol×", minval = 0, step = 0.1, group = G15, inline = "b")
bool  fv15 = input.bool(true, "FVG", group = G15, inline = "b")
float mx15 = input.float(2.0, "MaxSize×ATR", minval = 0.1, step = 0.1, group = G15, inline = "b")

string G30 = "30m"
bool  on30 = input.bool(true, "Show", group = G30, inline = "a")
int   sw30 = input.int(7, "Swing", minval = 2, group = G30, inline = "a")
float dp30 = input.float(1.4, "Disp×ATR", minval = 0, step = 0.1, group = G30, inline = "a")
float vl30 = input.float(1.2, "Vol×", minval = 0, step = 0.1, group = G30, inline = "b")
bool  fv30 = input.bool(false, "FVG", group = G30, inline = "b")
float mx30 = input.float(2.25, "MaxSize×ATR", minval = 0.1, step = 0.1, group = G30, inline = "b")

string G45 = "45m"
bool  on45 = input.bool(true, "Show", group = G45, inline = "a")
int   sw45 = input.int(6, "Swing", minval = 2, group = G45, inline = "a")
float dp45 = input.float(1.3, "Disp×ATR", minval = 0, step = 0.1, group = G45, inline = "a")
float vl45 = input.float(1.1, "Vol×", minval = 0, step = 0.1, group = G45, inline = "b")
bool  fv45 = input.bool(false, "FVG", group = G45, inline = "b")
float mx45 = input.float(2.5, "MaxSize×ATR", minval = 0.1, step = 0.1, group = G45, inline = "b")

string G60 = "1H"
bool  on60 = input.bool(true, "Show", group = G60, inline = "a")
int   sw60 = input.int(5, "Swing", minval = 2, group = G60, inline = "a")
float dp60 = input.float(1.2, "Disp×ATR", minval = 0, step = 0.1, group = G60, inline = "a")
float vl60 = input.float(1.0, "Vol×", minval = 0, step = 0.1, group = G60, inline = "b")
bool  fv60 = input.bool(false, "FVG", group = G60, inline = "b")
float mx60 = input.float(2.75, "MaxSize×ATR", minval = 0.1, step = 0.1, group = G60, inline = "b")

string G240 = "4H  — loosest"
bool  on240 = input.bool(true, "Show", group = G240, inline = "a")
int   sw240 = input.int(4, "Swing", minval = 2, group = G240, inline = "a")
float dp240 = input.float(1.0, "Disp×ATR", minval = 0, step = 0.1, group = G240, inline = "a")
float vl240 = input.float(0.0, "Vol×", minval = 0, step = 0.1, group = G240, inline = "b")
bool  fv240 = input.bool(false, "FVG", group = G240, inline = "b")
float mx240 = input.float(3.0, "MaxSize×ATR", minval = 0.1, step = 0.1, group = G240, inline = "b")

bool useBody = zoneType == "Body"

// =====================================================================================
//  Detection — runs inside request.security on each timeframe
// =====================================================================================
detectOB(int swingLen, float dispMult, float volMult, bool needFvg, float maxSizeAtr, bool body) =>
    float atr    = ta.atr(14)
    float volAvg = ta.sma(volume, 20)
    float ph     = ta.pivothigh(high, swingLen, swingLen)
    float pl     = ta.pivotlow(low, swingLen, swingLen)

    var float swHigh       = na
    var int   swHighBar    = na
    var bool  swHighBroken = true
    var float swLow        = na
    var int   swLowBar     = na
    var bool  swLowBroken  = true

    var float bullTop  = na
    var float bullBot  = na
    var int   bullTime = na
    var float bullId   = 0.0
    var float bearTop  = na
    var float bearBot  = na
    var int   bearTime = na
    var float bearId   = 0.0

    if not na(ph)
        swHigh       := ph
        swHighBar    := bar_index - swingLen
        swHighBroken := false
    if not na(pl)
        swLow       := pl
        swLowBar    := bar_index - swingLen
        swLowBroken := false

    // ── Bullish OB: close breaks above the last swing high (BOS up)
    if not swHighBroken and not na(swHigh) and close > swHigh
        swHighBroken := true
        int   window = math.max(1, math.min(bar_index - swHighBar, MAX_LOOKBACK))
        int   idx    = 1
        float minL   = low[1]
        for i = 1 to window
            if low[i] < minL
                minL := low[i]
                idx  := i
        // prefer the last bearish candle at the origin of the up-leg
        int obIdx = idx
        if close[idx] >= open[idx]
            for j = idx + 1 to idx + 2
                if close[j] < open[j]
                    obIdx := j
                    break
        float top = body ? math.max(open[obIdx], close[obIdx]) : high[obIdx]
        float bot = body ? math.min(open[obIdx], close[obIdx]) : minL

        float maxBody = 0.0
        float maxVol  = 0.0
        for k = 0 to obIdx - 1
            maxBody := math.max(maxBody, close[k] - open[k])
            maxVol  := math.max(maxVol, nz(volume[k]))
        bool fvgOk = not needFvg
        if needFvg and obIdx >= 2
            for k = 0 to obIdx - 2
                if low[k] > high[k + 2]
                    fvgOk := true
                    break
        bool  dispOk = maxBody >= dispMult * atr
        bool  volOk  = volMult <= 0 or na(volAvg) or volAvg <= 0 or maxVol >= volMult * volAvg
        float zoneH  = top - bot
        bool  sizeOk = zoneH > 0 and zoneH <= maxSizeAtr * atr
        if dispOk and volOk and fvgOk and sizeOk
            bullTop  := top
            bullBot  := bot
            bullTime := time[obIdx]
            bullId   += 1

    // ── Bearish OB: close breaks below the last swing low (BOS down)
    if not swLowBroken and not na(swLow) and close < swLow
        swLowBroken := true
        int   window = math.max(1, math.min(bar_index - swLowBar, MAX_LOOKBACK))
        int   idx    = 1
        float maxH   = high[1]
        for i = 1 to window
            if high[i] > maxH
                maxH := high[i]
                idx  := i
        // prefer the last bullish candle at the origin of the down-leg
        int obIdx = idx
        if close[idx] <= open[idx]
            for j = idx + 1 to idx + 2
                if close[j] > open[j]
                    obIdx := j
                    break
        float top = body ? math.max(open[obIdx], close[obIdx]) : maxH
        float bot = body ? math.min(open[obIdx], close[obIdx]) : low[obIdx]

        float maxBody = 0.0
        float maxVol  = 0.0
        for k = 0 to obIdx - 1
            maxBody := math.max(maxBody, open[k] - close[k])
            maxVol  := math.max(maxVol, nz(volume[k]))
        bool fvgOk = not needFvg
        if needFvg and obIdx >= 2
            for k = 0 to obIdx - 2
                if high[k] < low[k + 2]
                    fvgOk := true
                    break
        bool  dispOk = maxBody >= dispMult * atr
        bool  volOk  = volMult <= 0 or na(volAvg) or volAvg <= 0 or maxVol >= volMult * volAvg
        float zoneH  = top - bot
        bool  sizeOk = zoneH > 0 and zoneH <= maxSizeAtr * atr
        if dispOk and volOk and fvgOk and sizeOk
            bearTop  := top
            bearBot  := bot
            bearTime := time[obIdx]
            bearId   += 1

    // previous (closed) bar values + lookahead_on  →  no repaint
    [bullTop[1], bullBot[1], bullTime[1], bullId[1], bearTop[1], bearBot[1], bearTime[1], bearId[1]]

// =====================================================================================
//  Requests
// =====================================================================================
[b5T, b5B, b5Tm, b5Id, s5T, s5B, s5Tm, s5Id]                 = request.security(syminfo.tickerid, "5",   detectOB(sw5,   dp5   * strictMult, vl5   * strictMult, fv5,   mx5   / strictMult, useBody), lookahead = barmerge.lookahead_on)
[b10T, b10B, b10Tm, b10Id, s10T, s10B, s10Tm, s10Id]         = request.security(syminfo.tickerid, "10",  detectOB(sw10,  dp10  * strictMult, vl10  * strictMult, fv10,  mx10  / strictMult, useBody), lookahead = barmerge.lookahead_on)
[b15T, b15B, b15Tm, b15Id, s15T, s15B, s15Tm, s15Id]         = request.security(syminfo.tickerid, "15",  detectOB(sw15,  dp15  * strictMult, vl15  * strictMult, fv15,  mx15  / strictMult, useBody), lookahead = barmerge.lookahead_on)
[b30T, b30B, b30Tm, b30Id, s30T, s30B, s30Tm, s30Id]         = request.security(syminfo.tickerid, "30",  detectOB(sw30,  dp30  * strictMult, vl30  * strictMult, fv30,  mx30  / strictMult, useBody), lookahead = barmerge.lookahead_on)
[b45T, b45B, b45Tm, b45Id, s45T, s45B, s45Tm, s45Id]         = request.security(syminfo.tickerid, "45",  detectOB(sw45,  dp45  * strictMult, vl45  * strictMult, fv45,  mx45  / strictMult, useBody), lookahead = barmerge.lookahead_on)
[b60T, b60B, b60Tm, b60Id, s60T, s60B, s60Tm, s60Id]         = request.security(syminfo.tickerid, "60",  detectOB(sw60,  dp60  * strictMult, vl60  * strictMult, fv60,  mx60  / strictMult, useBody), lookahead = barmerge.lookahead_on)
[b240T, b240B, b240Tm, b240Id, s240T, s240B, s240Tm, s240Id] = request.security(syminfo.tickerid, "240", detectOB(sw240, dp240 * strictMult, vl240 * strictMult, fv240, mx240 / strictMult, useBody), lookahead = barmerge.lookahead_on)

// =====================================================================================
//  Drawing & mitigation (chart timeframe)
// =====================================================================================
type OB
    box   bx
    float top
    float bot
    bool  active

var array<OB> bull5   = array.new<OB>()
var array<OB> bear5   = array.new<OB>()
var array<OB> bull10  = array.new<OB>()
var array<OB> bear10  = array.new<OB>()
var array<OB> bull15  = array.new<OB>()
var array<OB> bear15  = array.new<OB>()
var array<OB> bull30  = array.new<OB>()
var array<OB> bear30  = array.new<OB>()
var array<OB> bull45  = array.new<OB>()
var array<OB> bear45  = array.new<OB>()
var array<OB> bull60  = array.new<OB>()
var array<OB> bear60  = array.new<OB>()
var array<OB> bull240 = array.new<OB>()
var array<OB> bear240 = array.new<OB>()

tfOk(string tf) =>
    not onlyHigher or timeframe.in_seconds(tf) >= timeframe.in_seconds(timeframe.period)

hasOverlap(array<OB> arr, float top, float bot) =>
    bool res = false
    for ob in arr
        if ob.active and top >= ob.bot and bot <= ob.top
            res := true
            break
    res

addOB(array<OB> arr, float top, float bot, int t, bool bull, string tfName, int transp, int bw) =>
    color base = bull ? bullCol : bearCol
    box bx = box.new(t, top, time, bot, xloc = xloc.bar_time, border_color = color.new(base, 25), border_width = bw, bgcolor = color.new(base, transp), text = tfName + (bull ? " Bull OB" : " Bear OB"), text_size = size.tiny, text_color = txtCol, text_halign = text.align_right, text_valign = text.align_center)
    arr.unshift(OB.new(bx, top, bot, true))
    if arr.size() > maxPerTF
        OB old = arr.pop()
        old.bx.delete()

updateOBs(array<OB> arr, bool bull) =>
    int n = arr.size()
    if n > 0
        for i = n - 1 to 0
            OB ob = arr.get(i)
            if ob.active
                float src    = mitMode == "Close" ? close : bull ? low : high
                bool  broken = bull ? src < ob.bot : src > ob.top
                if broken
                    ob.active := false
                    if hideMit
                        arr.remove(i)
                        ob.bx.delete()
                    else
                        ob.bx.set_right(time)
                        ob.bx.set_bgcolor(color.new(mitCol, 88))
                        ob.bx.set_border_color(color.new(mitCol, 60))
                else
                    ob.bx.set_right(time)

processTF(bool enabled, string tfName, array<OB> bulls, array<OB> bears, float bT, float bB, int bTm, float bId, float sT, float sB, int sTm, float sId, int transp, int bw) =>
    bool newBull = enabled and not na(bId) and bId != nz(bId[1], -1.0) and not na(bT) and not na(bB) and not na(bTm)
    bool newBear = enabled and not na(sId) and sId != nz(sId[1], -1.0) and not na(sT) and not na(sB) and not na(sTm)
    if newBull and not (noOverlap and hasOverlap(bulls, bT, bB))
        addOB(bulls, bT, bB, bTm, true, tfName, transp, bw)
        if alertsOn
            alert("MTF OB | New BULLISH order block on " + tfName + " | " + syminfo.ticker + " | " + str.tostring(bB, format.mintick) + " – " + str.tostring(bT, format.mintick), alert.freq_once_per_bar)
    if newBear and not (noOverlap and hasOverlap(bears, sT, sB))
        addOB(bears, sT, sB, sTm, false, tfName, transp, bw)
        if alertsOn
            alert("MTF OB | New BEARISH order block on " + tfName + " | " + syminfo.ticker + " | " + str.tostring(sB, format.mintick) + " – " + str.tostring(sT, format.mintick), alert.freq_once_per_bar)
    updateOBs(bulls, true)
    updateOBs(bears, false)

// higher timeframe → more opaque & thicker border (stronger zone)
processTF(on5   and tfOk("5"),   "5m",  bull5,   bear5,   b5T,   b5B,   b5Tm,   b5Id,   s5T,   s5B,   s5Tm,   s5Id,   88, 1)
processTF(on10  and tfOk("10"),  "10m", bull10,  bear10,  b10T,  b10B,  b10Tm,  b10Id,  s10T,  s10B,  s10Tm,  s10Id,  86, 1)
processTF(on15  and tfOk("15"),  "15m", bull15,  bear15,  b15T,  b15B,  b15Tm,  b15Id,  s15T,  s15B,  s15Tm,  s15Id,  84, 1)
processTF(on30  and tfOk("30"),  "30m", bull30,  bear30,  b30T,  b30B,  b30Tm,  b30Id,  s30T,  s30B,  s30Tm,  s30Id,  81, 1)
processTF(on45  and tfOk("45"),  "45m", bull45,  bear45,  b45T,  b45B,  b45Tm,  b45Id,  s45T,  s45B,  s45Tm,  s45Id,  78, 1)
processTF(on60  and tfOk("60"),  "1H",  bull60,  bear60,  b60T,  b60B,  b60Tm,  b60Id,  s60T,  s60B,  s60Tm,  s60Id,  74, 2)
processTF(on240 and tfOk("240"), "4H",  bull240, bear240, b240T, b240B, b240Tm, b240Id, s240T, s240B, s240Tm, s240Id, 68, 2)

// =====================================================================================
//  Info table
// =====================================================================================
var table infoT = table.new(position.top_right, 7, 8, bgcolor = color.new(color.black, 75), frame_color = color.new(color.gray, 60), frame_width = 1, border_color = color.new(color.gray, 80), border_width = 1)

countActive(array<OB> arr) =>
    int c = 0
    for ob in arr
        if ob.active
            c += 1
    c

setCell(int col, int row, string txt, color c) =>
    infoT.cell(col, row, txt, text_color = c, text_size = size.small)

fillRow(int row, string tfName, bool enabled, int sw, float dp, float vl, bool fv, array<OB> bulls, array<OB> bears) =>
    color c = enabled ? txtCol : color.new(txtCol, 70)
    setCell(0, row, tfName, c)
    setCell(1, row, str.tostring(sw), c)
    setCell(2, row, str.tostring(dp * strictMult, "#.##"), c)
    setCell(3, row, vl > 0 ? str.tostring(vl * strictMult, "#.##") : "off", c)
    setCell(4, row, fv ? "✔" : "–", c)
    setCell(5, row, enabled ? str.tostring(countActive(bulls)) : "–", enabled ? bullCol : c)
    setCell(6, row, enabled ? str.tostring(countActive(bears)) : "–", enabled ? bearCol : c)

if showTable and barstate.islast
    setCell(0, 0, "TF",    txtCol)
    setCell(1, 0, "Swing", txtCol)
    setCell(2, 0, "Disp",  txtCol)
    setCell(3, 0, "Vol",   txtCol)
    setCell(4, 0, "FVG",   txtCol)
    setCell(5, 0, "Bull",  bullCol)
    setCell(6, 0, "Bear",  bearCol)
    fillRow(1, "5m",  on5   and tfOk("5"),   sw5,   dp5,   vl5,   fv5,   bull5,   bear5)
    fillRow(2, "10m", on10  and tfOk("10"),  sw10,  dp10,  vl10,  fv10,  bull10,  bear10)
    fillRow(3, "15m", on15  and tfOk("15"),  sw15,  dp15,  vl15,  fv15,  bull15,  bear15)
    fillRow(4, "30m", on30  and tfOk("30"),  sw30,  dp30,  vl30,  fv30,  bull30,  bear30)
    fillRow(5, "45m", on45  and tfOk("45"),  sw45,  dp45,  vl45,  fv45,  bull45,  bear45)
    fillRow(6, "1H",  on60  and tfOk("60"),  sw60,  dp60,  vl60,  fv60,  bull60,  bear60)
    fillRow(7, "4H",  on240 and tfOk("240"), sw240, dp240, vl240, fv240, bull240, bear240)
