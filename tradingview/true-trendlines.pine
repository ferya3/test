//@version=6
// True Trendlines — pivot-anchored trendlines validated the way discretionary
// traders draw them: anchored on confirmed swing points (DeMark), no candle
// closes through the line, more touches = stronger line, and a close beyond
// the line (optionally on volume) is the breakout. Broken lines are watched
// for the classic break-and-retest (role reversal).
indicator("True Trendlines [Pivot · Touch · Breakout]", shorttitle = "True TL", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 2000)

// ─── Inputs ──────────────────────────────────────────────────────────────────
const string G_PIV = "Pivots"
const string G_TL  = "Trendline rules"
const string G_SIG = "Breakout & Retest"
const string G_STY = "Style"

int    pivLen     = input.int(5, "Pivot strength", minval = 2, maxval = 50, group = G_PIV, tooltip = "تعداد کندل در هر طرف برای تایید سقف/کف (روش DeMark). عدد بزرگ‌تر = خطوط بلندمدت‌تر و معتبرتر، ولی با تاخیر بیشتر.")
string anchorMode = input.string("Wicks", "Anchor on", options = ["Wicks", "Bodies"], group = G_PIV, tooltip = "Wicks: خط روی سایه‌ها (کلاسیک). Bodies: خط روی بدنه کندل‌ها (سبک تریدرهای پرایس‌اکشن که نویز سایه را حذف می‌کنند).")
int    maxCands   = input.int(15, "Pivots to compare", minval = 2, maxval = 50, group = G_PIV, tooltip = "هر پیوت جدید با چند پیوت قبلی مقایسه شود تا بهترین خط پیدا شود.")
int    calcBars   = input.int(3000, "Calculate on last N bars", minval = 300, maxval = 20000, group = G_PIV)

int   minTouch   = input.int(2, "Min touches to draw", minval = 2, maxval = 6, group = G_TL)
int   confTouch  = input.int(3, "Touches for a confirmed line", minval = 2, maxval = 10, group = G_TL, tooltip = "خطی که این تعداد برخورد داشته باشد «تایید‌شده» است و ضخیم‌تر کشیده می‌شود. اکثر تریدرهای حرفه‌ای ۳ برخورد را معیار می‌دانند.")
int   minSpan    = input.int(10, "Min bars between anchors", minval = 3, group = G_TL)
int   maxSpan    = input.int(300, "Max bars between anchors", minval = 20, maxval = 1500, group = G_TL)
float tolMult    = input.float(0.25, "Touch tolerance (× ATR)", minval = 0.0, step = 0.05, group = G_TL, tooltip = "فاصله‌ای که هنوز «برخورد» حساب می‌شود.")
float maxSlope   = input.float(1.0, "Max steepness (ATR per bar)", minval = 0.05, step = 0.05, group = G_TL, tooltip = "خطوط خیلی تند (حرکت‌های سهمی) پایدار نیستند و حذف می‌شوند.")
int   maxPerSide = input.int(3, "Active lines per side", minval = 1, maxval = 10, group = G_TL)
int   staleBars  = input.int(200, "Drop line after N bars without touch", minval = 20, group = G_TL)

float brkMult    = input.float(0.1, "Break buffer (× ATR)", minval = 0.0, step = 0.05, group = G_SIG, tooltip = "شکست فقط وقتی معتبر است که کندل با این فاصله آن طرف خط بسته شود (فیلتر فیک‌اوت).")
bool  useVol     = input.bool(false, "Require volume above average", group = G_SIG)
float volMult    = input.float(1.2, "Volume multiplier", minval = 0.5, step = 0.1, group = G_SIG)
bool  showRetest = input.bool(true, "Show retest signals", group = G_SIG)
int   retestBars = input.int(20, "Retest window (bars)", minval = 2, group = G_SIG)
int   keepBroken = input.int(3, "Broken lines kept per side", minval = 0, maxval = 20, group = G_SIG, tooltip = "برای سیگنال ری‌تست حداقل ۱ لازم است.")

color colRes    = input.color(#ef5350, "Resistance", group = G_STY)
color colSup    = input.color(#26a69a, "Support", group = G_STY)
color colBroken = input.color(color.gray, "Broken", group = G_STY)
int   confWidth = input.int(2, "Confirmed line width", minval = 1, maxval = 5, group = G_STY)
bool  showTouch = input.bool(true, "Show touch count", group = G_STY)
bool  showSig   = input.bool(true, "Show breakout labels", group = G_STY)

const string G_MTF = "Higher-timeframe trendlines"
bool   htf1On = input.bool(true, "", group = G_MTF, inline = "h1", tooltip = "همان قواعد ترندلاین روی کندل‌های تایم‌فریم بالاتر اجرا می‌شود و خط روی چارت فعلی، دقیقاً از نوک کندل، کشیده می‌شود. فقط وقتی نمایش داده می‌شود که تایم‌فریم چارت کوچک‌تر باشد.")
string htf1Tf = input.timeframe("240", "", group = G_MTF, inline = "h1")
bool   htf2On = input.bool(true, "", group = G_MTF, inline = "h2")
string htf2Tf = input.timeframe("D", "", group = G_MTF, inline = "h2")
int    htfPiv = input.int(3, "HTF pivot strength", minval = 2, maxval = 20, group = G_MTF, tooltip = "تعداد کندل تایم‌فریم بالا در هر طرف پیوت. چون کندل‌های بالاتر بزرگ‌ترند، عدد کمتری لازم است.")

const string G_OB = "Order blocks (strict)"
bool   obOn        = input.bool(true, "Show order blocks", group = G_OB, tooltip = "اوردر بلاک = آخرین کندل مخالف قبل از حرکت قوی‌ای که ساختار (آخرین سقف/کف سوئینگ) را با کلوز می‌شکند. فقط وقتی رسم می‌شود که همه فیلترهای فعال پاس شوند.")
int    obPiv       = input.int(5, "Structure pivot strength", minval = 2, maxval = 20, group = G_OB, tooltip = "سقف/کف سوئینگی که شکستش (BOS) لازم است.")
string obZone      = input.string("Wick", "Zone", options = ["Wick", "Body"], group = G_OB, tooltip = "Wick: کل کندل اوردر بلاک (سایه تا سایه). Body: فقط بدنه.")
float  obDisp      = input.float(2.0, "Min impulse (× ATR)", minval = 0.5, step = 0.25, group = G_OB, tooltip = "فاصله کلوز شکست تا لبه اوردر بلاک باید حداقل این مقدار باشد (حرکت قوی / Displacement).")
float  obBody      = input.float(1.0, "Min displacement candle body (× ATR)", minval = 0.25, step = 0.25, group = G_OB, tooltip = "حداقل یک کندل در حرکت باید بدنه‌ای به این بزرگی داشته باشد.")
bool   obFvg       = input.bool(true, "Require fair value gap", group = G_OB, tooltip = "حرکت باید گپ ارزش منصفانه (FVG / Imbalance) به جا بگذارد.")
bool   obSweep     = input.bool(false, "Require liquidity sweep", group = G_OB, tooltip = "اوردر بلاک باید یکی از سقف/کف‌های قبلی را جارو کرده باشد (شکار نقدینگی). سخت‌گیرانه‌ترین فیلتر.")
bool   obVol       = input.bool(false, "Require above-average volume", group = G_OB)
bool   obTrend     = input.bool(false, "Only with trend (EMA 200)", group = G_OB)
int    obMaxLeg    = input.int(100, "Max bars from swing to break", minval = 10, maxval = 500, group = G_OB)
int    obMax       = input.int(3, "Active order blocks per side", minval = 1, maxval = 10, group = G_OB)
int    obMaxAge    = input.int(500, "Drop order block after N bars", minval = 20, group = G_OB)
bool   obHideTap   = input.bool(false, "Remove after first tap", group = G_OB, tooltip = "خاموش: بعد از اولین برخورد کم‌رنگ و خط‌چین می‌شود. روشن: بعد از اولین برخورد حذف می‌شود.")
bool   obMid       = input.bool(true, "Show 50% line", group = G_OB)
color  obBullCol   = input.color(#089981, "Bullish", group = G_OB, inline = "obc")
color  obBearCol   = input.color(#f23645, "Bearish", group = G_OB, inline = "obc")

const string G_OBM = "Higher-timeframe order blocks"
bool   obH1On  = input.bool(true, "", group = G_OBM, inline = "o1", tooltip = "همان اوردر بلاک با همه فیلترهای بالا، روی کندل‌های تایم‌فریم بالاتر. دو اوردر بلاک زنده آخر هر جهت روی چارت فعلی کشیده می‌شود. فقط وقتی نمایش داده می‌شود که تایم‌فریم چارت کوچک‌تر باشد.")
string obH1Tf  = input.timeframe("240", "", group = G_OBM, inline = "o1")
bool   obH2On  = input.bool(true, "", group = G_OBM, inline = "o2")
string obH2Tf  = input.timeframe("D", "", group = G_OBM, inline = "o2")
int    obH_Piv = input.int(3, "HTF structure pivot strength", minval = 2, maxval = 20, group = G_OBM)

const string G_PP = "Previous period H / L / C (multi-timeframe)"
bool   pp1On     = input.bool(true, "", group = G_PP, inline = "p1", tooltip = "سقف، کف و کلوز دوره قبل در هر تایم‌فریم، دقیقاً از نوک کندلی که آن را ساخته. هر دوره فقط در چارت‌هایی با تایم‌فریم کوچک‌تر نمایش داده می‌شود.")
string pp1Tf     = input.timeframe("D", "", group = G_PP, inline = "p1")
color  pp1Col    = input.color(#9c27b0, "", group = G_PP, inline = "p1")
bool   pp2On     = input.bool(true, "", group = G_PP, inline = "p2")
string pp2Tf     = input.timeframe("W", "", group = G_PP, inline = "p2")
color  pp2Col    = input.color(#2962ff, "", group = G_PP, inline = "p2")
bool   pp3On     = input.bool(false, "", group = G_PP, inline = "p3")
string pp3Tf     = input.timeframe("M", "", group = G_PP, inline = "p3")
color  pp3Col    = input.color(#ff9800, "", group = G_PP, inline = "p3")
bool   ppClose   = input.bool(true, "Show close", group = G_PP)
string ppStyleIn = input.string("Dashed", "Line style", options = ["Solid", "Dashed", "Dotted"], group = G_PP)
bool   ppHist    = input.bool(false, "Show past periods too", group = G_PP)
bool   ppLabels  = input.bool(true, "Show labels with price", group = G_PP)

// ─── Series ──────────────────────────────────────────────────────────────────
bool  bodyMode = anchorMode == "Bodies"
float hSrc     = bodyMode ? math.max(open, close) : high
float lSrc     = bodyMode ? math.min(open, close) : low
float ph       = ta.pivothigh(hSrc, pivLen, pivLen)
float pl       = ta.pivotlow(lSrc, pivLen, pivLen)
float atrV     = ta.atr(14)
float tol      = atrV * tolMult
float brkBuf   = atrV * brkMult
float volAvg   = ta.sma(volume, 20)
bool  volOk    = not useVol or volume > volAvg * volMult
bool  inWindow = bar_index >= last_bar_index - calcBars


// ─── Types ───────────────────────────────────────────────────────────────────
type Pivot
    int   idx
    float price

type TL
    line  ln
    label lb
    int   x1
    float y1
    float slope
    int   touches
    bool  isRes
    int   lastTouch
    int   brokenBar = na
    bool  done      = false

type OB
    box   bx
    line  mid
    float top
    float btm
    bool  bull
    int   born
    bool  tapped = false

// One higher-timeframe period: the running H/L of the period in progress and
// the H/L/C of the last completed one, each with the bar that set it.
type Period
    string pfx
    color  col
    bool   enabled
    float  curH    = na
    float  curL    = na
    int    curHBar = na
    int    curLBar = na
    float  pH      = na
    float  pL      = na
    float  pC      = na
    int    pHBar   = na
    int    pLBar   = na
    int    pCBar   = na

method valueAt(TL this, int x) =>
    this.y1 + this.slope * (x - this.x1)

method restyle(TL this) =>
    color c    = this.isRes ? colRes : colSup
    bool  conf = this.touches >= confTouch
    this.ln.set_color(conf ? c : color.new(c, 40))
    this.ln.set_width(conf ? confWidth : 1)
    if not na(this.lb)
        this.lb.set_text(str.tostring(this.touches) + (conf ? "× ✓" : "×"))
        this.lb.set_textcolor(c)

// Taken from the chart's own candles, so a level sits exactly on the wick
// that made it.
method track(Period this, bool chg) =>
    if chg
        this.pH    := this.curH
        this.pHBar := this.curHBar
        this.pL    := this.curL
        this.pLBar := this.curLBar
        this.pC    := close[1]
        this.pCBar := bar_index - 1
        this.curH  := na
        this.curL  := na
    if na(this.curH) or high > this.curH
        this.curH    := high
        this.curHBar := bar_index
    if na(this.curL) or low < this.curL
        this.curL    := low
        this.curLBar := bar_index

method kill(TL this) =>
    this.ln.delete()
    if not na(this.lb)
        this.lb.delete()

// ─── Trendline search ────────────────────────────────────────────────────────
// A line is valid only if no close, from its first anchor up to now, sits
// beyond it by more than the break buffer.
f_holds(int x1, float y1, float s, bool isRes) =>
    int  span = bar_index - x1
    bool ok   = true
    for k = 0 to span
        float lv = y1 + s * (span - k)
        if isRes ? close[k] > lv + brkBuf : close[k] < lv - brkBuf
            ok := false
            break
    ok

// Number of swing points (anchors included) that sit on the line.
f_touches(array<Pivot> pivs, int x1, float y1, float s) =>
    int n = 0
    for p in pivs
        if p.idx >= x1 and math.abs(p.price - (y1 + s * (p.idx - x1))) <= tol
            n := n + 1
    n

// Pair the newest pivot with an older one: lower highs for resistance, higher
// lows for support. Most touches wins, ties go to the longer line.
f_findBest(array<Pivot> pivs, bool isRes) =>
    int   bestI     = -1
    int   bestT     = 0
    int   bestSpan  = 0
    float bestSlope = na
    int   sz        = pivs.size()
    if sz >= 2
        Pivot nw = pivs.get(sz - 1)
        int   lo = math.max(0, sz - 1 - maxCands)
        for i = sz - 2 to lo
            Pivot od   = pivs.get(i)
            int   span = nw.idx - od.idx
            if span > maxSpan
                break
            bool  dirOk = isRes ? od.price > nw.price : od.price < nw.price
            float s     = (nw.price - od.price) / span
            if dirOk and span >= minSpan and math.abs(s) <= maxSlope * atrV
                if f_holds(od.idx, od.price, s, isRes)
                    int tc = f_touches(pivs, od.idx, od.price, s)
                    if tc > bestT or (tc == bestT and span > bestSpan)
                        bestI     := i
                        bestT     := tc
                        bestSpan  := span
                        bestSlope := s
    [bestI, bestT, bestSlope]

f_onPivot(array<Pivot> pivs, array<TL> act, float price, bool isRes) =>
    int pIdx = bar_index - pivLen
    pivs.push(Pivot.new(pIdx, price))
    if pivs.size() > 100
        pivs.shift()
    // A swing that lands on an existing line strengthens it instead of
    // spawning a near-duplicate.
    bool touched = false
    for t in act
        if math.abs(price - t.valueAt(pIdx)) <= tol
            t.touches   := t.touches + 1
            t.lastTouch := pIdx
            touched     := true
            if not na(t.lb)
                t.lb.set_xy(pIdx, price)
            t.restyle()
    if not touched and inWindow
        [bi, bt, bs] = f_findBest(pivs, isRes)
        if bi >= 0 and bt >= minTouch
            Pivot od = pivs.get(bi)
            color c  = isRes ? colRes : colSup
            line  ln = line.new(od.idx, od.price, pIdx, price, extend = extend.right, color = c, width = 1)
            label lb = showTouch ? label.new(pIdx, price, "", style = isRes ? label.style_label_down : label.style_label_up, color = color(na), textcolor = c, size = size.small) : na
            TL nt = TL.new(ln = ln, lb = lb, x1 = od.idx, y1 = od.price, slope = bs, touches = bt, isRes = isRes, lastTouch = pIdx)
            nt.restyle()
            act.push(nt)
            while act.size() > maxPerSide
                TL gone = act.shift()
                gone.kill()

// Breaks active lines on a close beyond them, then watches broken lines for a
// retest from the other side. Returns [breakout, retest].
f_process(array<TL> act, array<TL> brk, bool isRes) =>
    bool bo = false
    bool rt = false
    int  n  = act.size()
    if n > 0
        for i = n - 1 to 0
            TL    t = act.get(i)
            float v = t.valueAt(bar_index)
            if isRes ? close > v + brkBuf : close < v - brkBuf
                t.brokenBar := bar_index
                t.ln.set_xy2(bar_index, v)
                t.ln.set_extend(extend.none)
                t.ln.set_style(line.style_dashed)
                t.ln.set_color(colBroken)
                t.ln.set_width(1)
                act.remove(i)
                brk.push(t)
                bo := bo or volOk
            else if bar_index - t.lastTouch > staleBars
                t.kill()
                act.remove(i)
    for b in brk
        if not b.done and bar_index > b.brokenBar
            float v      = b.valueAt(bar_index)
            bool  failed = isRes ? close < v - brkBuf : close > v + brkBuf
            bool  hit    = isRes ? (low <= v + tol and close > v) : (high >= v - tol and close < v)
            if failed or bar_index - b.brokenBar > retestBars
                b.done := true
            else if hit
                b.done := true
                b.ln.set_xy2(bar_index, v)
                rt := true
    while brk.size() > keepBroken
        TL gone = brk.shift()
        gone.kill()
    [bo, rt]

// ─── Main ────────────────────────────────────────────────────────────────────
var array<Pivot> pHi       = array.new<Pivot>()
var array<Pivot> pLo       = array.new<Pivot>()
var array<TL>    resLines  = array.new<TL>()
var array<TL>    supLines  = array.new<TL>()
var array<TL>    resBroken = array.new<TL>()
var array<TL>    supBroken = array.new<TL>()

[resBO, resRT] = f_process(resLines, resBroken, true)
[supBD, supRT] = f_process(supLines, supBroken, false)

if not na(ph)
    f_onPivot(pHi, resLines, ph, true)
if not na(pl)
    f_onPivot(pLo, supLines, pl, false)

// ─── Higher-timeframe trendlines ─────────────────────────────────────────────
// "1D" → "D", "240" → "4H", "15" → "15m"
f_tfName(string tf) =>
    string n   = tf == "1D" ? "D" : tf == "1W" ? "W" : tf == "1M" ? "M" : tf
    bool   dwm = str.contains(n, "D") or str.contains(n, "W") or str.contains(n, "M") or str.contains(n, "S")
    int    m   = dwm ? 0 : int(str.tonumber(n))
    dwm ? n : m % 60 == 0 ? str.tostring(int(m / 60)) + "H" : str.tostring(m) + "m"

int chartSec = timeframe.in_seconds()

// The same rules as above, run on the higher timeframe's own candles inside
// request.security. Only numbers come back: the newest line's anchor times
// and prices, its touches, and when/where it broke (na while intact).
// off = 1 in realtime returns the last completed HTF bar, so nothing repaints.
f_htfSide(simple int len, bool isRes, int off) =>
    float a   = ta.atr(14)
    float tl  = a * tolMult
    float bb  = a * brkMult
    float ph_ = ta.pivothigh(high, len, len)
    float pl_ = ta.pivotlow(low, len, len)
    float piv = isRes ? ph_ : pl_
    var array<int>   pIdx = array.new<int>()
    var array<float> pPr  = array.new<float>()
    var array<int>   pT   = array.new<int>()
    var int   x1   = na
    var float y1   = na
    var float sl   = na
    var int   t1   = na
    var int   t2   = na
    var float y2   = na
    var int   tch  = 0
    var int   brkT = na
    var float brkY = na
    if not na(x1) and na(brkT)
        float v = y1 + sl * (bar_index - x1)
        if isRes ? close > v + bb : close < v - bb
            brkT := time
            brkY := v
    if not na(piv)
        int idx = bar_index - len
        pIdx.push(idx)
        pPr.push(piv)
        pT.push(time[len])
        if pIdx.size() > 100
            pIdx.shift()
            pPr.shift()
            pT.shift()
        bool onLine = not na(x1) and na(brkT) and math.abs(piv - (y1 + sl * (idx - x1))) <= tl
        if onLine
            tch := tch + 1
        else
            int   sz       = pIdx.size()
            int   bestI    = -1
            int   bestT    = 0
            int   bestSpan = 0
            float bestS    = na
            if sz >= 2
                int lo = math.max(0, sz - 1 - maxCands)
                for i = sz - 2 to lo
                    int   oIdx = pIdx.get(i)
                    float oP   = pPr.get(i)
                    int   span = idx - oIdx
                    if span > maxSpan
                        break
                    bool  dirOk = isRes ? oP > piv : oP < piv
                    float s     = (piv - oP) / span
                    if dirOk and span >= minSpan and math.abs(s) <= maxSlope * a
                        int  full = bar_index - oIdx
                        bool ok   = true
                        for k = 0 to full
                            float lv = oP + s * (full - k)
                            if isRes ? close[k] > lv + bb : close[k] < lv - bb
                                ok := false
                                break
                        if ok
                            int tc = 0
                            for j = 0 to sz - 1
                                int jx = pIdx.get(j)
                                if jx >= oIdx and math.abs(pPr.get(j) - (oP + s * (jx - oIdx))) <= tl
                                    tc := tc + 1
                            if tc > bestT or (tc == bestT and span > bestSpan)
                                bestI    := i
                                bestT    := tc
                                bestSpan := span
                                bestS    := s
            if bestI >= 0 and bestT >= minTouch
                x1   := pIdx.get(bestI)
                y1   := pPr.get(bestI)
                sl   := bestS
                t1   := pT.get(bestI)
                t2   := pT.get(sz - 1)
                y2   := piv
                tch  := bestT
                brkT := na
                brkY := na
    [t1[off], y1[off], t2[off], y2[off], tch[off], brkT[off], brkY[off]]

int iH = barstate.isrealtime ? 1 : 0
[a1t1, a1y1, a1t2, a1y2, a1tc, a1bt, a1by] = request.security(syminfo.tickerid, htf1Tf, f_htfSide(htfPiv, true, iH))
[b1t1, b1y1, b1t2, b1y2, b1tc, b1bt, b1by] = request.security(syminfo.tickerid, htf1Tf, f_htfSide(htfPiv, false, iH))
[a2t1, a2y1, a2t2, a2y2, a2tc, a2bt, a2by] = request.security(syminfo.tickerid, htf2Tf, f_htfSide(htfPiv, true, iH))
[b2t1, b2y1, b2t2, b2y2, b2tc, b2bt, b2by] = request.security(syminfo.tickerid, htf2Tf, f_htfSide(htfPiv, false, iH))

bool htf1Ok = htf1On and chartSec < timeframe.in_seconds(htf1Tf)
bool htf2Ok = htf2On and chartSec < timeframe.in_seconds(htf2Tf)

// Time of the chart candle inside an HTF candle [tOpen, tOpen + dur) whose
// wick reaches the HTF extreme, so the line sits exactly on that tip. Falls
// back to the HTF candle's open when it is beyond the chart's history.
f_tip(int tOpen, int dur, float price, bool isRes) =>
    int tt  = tOpen
    int lim = math.min(bar_index, 1990)
    for k = 0 to lim
        if time[k] < tOpen
            break
        if time[k] < tOpen + dur and (isRes ? high[k] >= price : low[k] <= price)
            tt := time[k]
            break
    tt

var array<line>  htfLines = array.new<line>()
var array<label> htfLbls  = array.new<label>()

f_htfDraw(int t1, float y1, int t2, float y2, int tch, int brkT, float brkY, bool isRes, int dur, string tag) =>
    if not na(t1)
        color c      = isRes ? colRes : colSup
        bool  broken = not na(brkT)
        int   x1     = f_tip(t1, dur, y1, isRes)
        int   x2     = f_tip(t2, dur, y2, isRes)
        line  ln     = line.new(x1, y1, x2, y2, xloc = xloc.bar_time, extend = broken ? extend.none : extend.right, color = broken ? colBroken : c, style = broken ? line.style_dashed : line.style_solid, width = tch >= confTouch ? confWidth + 1 : confWidth)
        if broken
            ln.set_xy2(brkT, brkY)
        htfLines.push(ln)
        if showTouch
            htfLbls.push(label.new(x2, y2, tag + " " + str.tostring(tch) + "×", xloc = xloc.bar_time, style = isRes ? label.style_label_down : label.style_label_up, color = color(na), textcolor = broken ? colBroken : c, size = size.small))

if barstate.islast
    for l in htfLines
        l.delete()
    for lb in htfLbls
        lb.delete()
    htfLines.clear()
    htfLbls.clear()
    int dur1 = timeframe.in_seconds(htf1Tf) * 1000
    int dur2 = timeframe.in_seconds(htf2Tf) * 1000
    if htf1Ok
        f_htfDraw(a1t1, a1y1, a1t2, a1y2, a1tc, a1bt, a1by, true, dur1, f_tfName(htf1Tf))
        f_htfDraw(b1t1, b1y1, b1t2, b1y2, b1tc, b1bt, b1by, false, dur1, f_tfName(htf1Tf))
    if htf2Ok
        f_htfDraw(a2t1, a2y1, a2t2, a2y2, a2tc, a2bt, a2by, true, dur2, f_tfName(htf2Tf))
        f_htfDraw(b2t1, b2y1, b2t2, b2y2, b2tc, b2bt, b2by, false, dur2, f_tfName(htf2Tf))

// An HTF break is reported once, on the chart bar where it arrives.
f_newBreak(int b) =>
    not na(b) and (na(b[1]) or b != b[1])
bool a1New = f_newBreak(a1bt)
bool b1New = f_newBreak(b1bt)
bool a2New = f_newBreak(a2bt)
bool b2New = f_newBreak(b2bt)
bool htfBO = (htf1Ok and a1New) or (htf2Ok and a2New)
bool htfBD = (htf1Ok and b1New) or (htf2Ok and b2New)

// ─── Order blocks (strict) ───────────────────────────────────────────────────
// Bullish OB: the last down-close candle at the origin of a leg that closes
// above the latest swing high (BOS), passing every enabled filter. Bearish is
// the mirror image. A zone dies on a close beyond its far edge.
float obPH  = ta.pivothigh(high, obPiv, obPiv)
float obPL  = ta.pivotlow(low, obPiv, obPiv)
float emaT  = ta.ema(close, 200)
bool  obBodyZone = obZone == "Body"

var float shP      = na
var int   shI      = na
var bool  shBroken = true
var float slP      = na
var int   slI      = na
var bool  slBroken = true
var array<float> shPr    = array.new<float>()
var array<int>   shIx    = array.new<int>()
var array<float> slPr    = array.new<float>()
var array<int>   slIx    = array.new<int>()
var array<OB>    bullOBs = array.new<OB>()
var array<OB>    bearOBs = array.new<OB>()

if not na(obPH)
    shP      := obPH
    shI      := bar_index - obPiv
    shBroken := false
    shPr.push(obPH)
    shIx.push(shI)
    if shPr.size() > 5
        shPr.shift()
        shIx.shift()
if not na(obPL)
    slP      := obPL
    slI      := bar_index - obPiv
    slBroken := false
    slPr.push(obPL)
    slIx.push(slI)
    if slPr.size() > 5
        slPr.shift()
        slIx.shift()

// Did the OB's wick take out one of the last swing lows (bull) / highs (bear)
// that formed before it?
f_swept(bool bull, float price, int beforeIdx) =>
    array<float> pr  = bull ? slPr : shPr
    array<int>   ix  = bull ? slIx : shIx
    bool         hit = false
    if pr.size() > 0
        for i = 0 to pr.size() - 1
            if ix.get(i) < beforeIdx and (bull ? price < pr.get(i) : price > pr.get(i))
                hit := true
    hit

// Returns [offset of the OB candle or -1, top, bottom].
f_findOB(bool bull, int fromIdx) =>
    int span = math.min(bar_index - fromIdx, 1990)
    // Extreme of the leg: lowest low (bull) / highest high (bear).
    int ek = 0
    for k = 0 to span
        if bull ? low[k] < low[ek] : high[k] > high[ek]
            ek := k
    // Last opposite-colour candle at that extreme or just before it.
    int obk = -1
    for k = ek to math.min(ek + 3, 1990)
        if bull ? close[k] < open[k] : close[k] > open[k]
            obk := k
            break
    float top  = na
    float btm  = na
    bool  pass = false
    if obk >= 1
        top := obBodyZone ? math.max(open[obk], close[obk]) : high[obk]
        btm := obBodyZone ? math.min(open[obk], close[obk]) : low[obk]
        float impulse = bull ? close - btm : top - close
        bool  disp    = false
        bool  fvg     = false
        float vsum    = 0.0
        for j = 0 to obk - 1
            float body = bull ? close[j] - open[j] : open[j] - close[j]
            if body >= obBody * atrV
                disp := true
            if j <= obk - 2 and (bull ? low[j] > high[j + 2] : high[j] < low[j + 2])
                fvg := true
            vsum := vsum + nz(volume[j])
        bool volPass   = not obVol or vsum / obk > volAvg * volMult
        bool trendPass = not obTrend or (bull ? close > emaT : close < emaT)
        bool sweepPass = not obSweep or f_swept(bull, bull ? low[obk] : high[obk], bar_index - obk)
        pass := impulse >= obDisp * atrV and disp and (fvg or not obFvg) and volPass and trendPass and sweepPass
    [pass ? obk : -1, top, btm]

f_newOB(bool bull, int fromIdx) =>
    [k, top, btm] = f_findOB(bull, fromIdx)
    bool made = false
    if k >= 1
        array<OB> lst     = bull ? bullOBs : bearOBs
        bool      overlap = false
        for o in lst
            if top >= o.btm and btm <= o.top
                overlap := true
        if not overlap
            color c  = bull ? obBullCol : obBearCol
            int   x1 = bar_index - k
            box   bx = box.new(x1, top, bar_index, btm, border_color = c, bgcolor = color.new(c, 80), text = bull ? "Bull OB" : "Bear OB", text_color = c, text_size = size.small, text_halign = text.align_right, text_valign = text.align_center)
            line  md = obMid ? line.new(x1, (top + btm) / 2, bar_index, (top + btm) / 2, color = c, style = line.style_dashed) : na
            lst.push(OB.new(bx, md, top, btm, bull, bar_index))
            made := true
            while lst.size() > obMax
                OB old = lst.shift()
                old.bx.delete()
                if not na(old.mid)
                    old.mid.delete()
    made

// Extends live zones, marks the first tap, and drops zones that are broken
// or too old. Returns true on a first tap.
f_obUpdate(array<OB> lst) =>
    bool tap = false
    int  n   = lst.size()
    if n > 0
        for i = n - 1 to 0
            OB   o    = lst.get(i)
            bool dead = (o.bull ? close < o.btm : close > o.top) or bar_index - o.born > obMaxAge
            bool hit  = not dead and not o.tapped and bar_index > o.born and (o.bull ? low <= o.top : high >= o.btm)
            if hit
                o.tapped := true
                tap      := true
                color c = o.bull ? obBullCol : obBearCol
                o.bx.set_bgcolor(color.new(c, 92))
                o.bx.set_border_style(line.style_dashed)
            if dead or (hit and obHideTap)
                o.bx.delete()
                if not na(o.mid)
                    o.mid.delete()
                lst.remove(i)
            else
                int xr = bar_index + (barstate.islast ? 10 : 0)
                o.bx.set_right(xr)
                if not na(o.mid)
                    o.mid.set_x2(xr)
    tap

bool obBullTap = f_obUpdate(bullOBs)
bool obBearTap = f_obUpdate(bearOBs)
bool obBullNew = false
bool obBearNew = false

if obOn and inWindow and not shBroken and close > shP
    shBroken := true
    if bar_index - shI <= obMaxLeg
        obBullNew := f_newOB(true, shI)
if obOn and inWindow and not slBroken and close < slP
    slBroken := true
    if bar_index - slI <= obMaxLeg
        obBearNew := f_newOB(false, slI)

// ─── Higher-timeframe order blocks ───────────────────────────────────────────
// The same strict OB rules, run on the higher timeframe's own candles inside
// request.security. Returns the two newest live zones: candle open time, top,
// bottom and whether the HTF has tapped it. off = 1 in realtime → no repaint.
f_htfOB(simple int len, bool bull, int off) =>
    float a   = ta.atr(14)
    float e   = ta.ema(close, 200)
    float va  = ta.sma(volume, 20)
    float ph_ = ta.pivothigh(high, len, len)
    float pl_ = ta.pivotlow(low, len, len)
    float sw  = bull ? ph_ : pl_
    float lq  = bull ? pl_ : ph_
    var float swP = na
    var int   swI = na
    var bool  swB = true
    var array<float> lqP  = array.new<float>()
    var array<int>   lqI  = array.new<int>()
    var array<int>   oT   = array.new<int>()
    var array<float> oTop = array.new<float>()
    var array<float> oBtm = array.new<float>()
    var array<bool>  oTap = array.new<bool>()
    if not na(sw)
        swP := sw
        swI := bar_index - len
        swB := false
    if not na(lq)
        lqP.push(lq)
        lqI.push(bar_index - len)
        if lqP.size() > 5
            lqP.shift()
            lqI.shift()
    if oT.size() > 0
        for i = oT.size() - 1 to 0
            float tp = oTop.get(i)
            float bt = oBtm.get(i)
            if bull ? close < bt : close > tp
                oT.remove(i)
                oTop.remove(i)
                oBtm.remove(i)
                oTap.remove(i)
            else if not oTap.get(i) and (bull ? low <= tp : high >= bt)
                oTap.set(i, true)
    if not swB and (bull ? close > swP : close < swP)
        swB := true
        int span = bar_index - swI
        if span <= obMaxLeg
            int ek = 0
            for k = 0 to span
                if bull ? low[k] < low[ek] : high[k] > high[ek]
                    ek := k
            int obk = -1
            for k = ek to ek + 3
                if bull ? close[k] < open[k] : close[k] > open[k]
                    obk := k
                    break
            if obk >= 1
                float top  = obBodyZone ? math.max(open[obk], close[obk]) : high[obk]
                float btm  = obBodyZone ? math.min(open[obk], close[obk]) : low[obk]
                float imp  = bull ? close - btm : top - close
                bool  disp = false
                bool  fvg  = false
                float vsum = 0.0
                for j = 0 to obk - 1
                    float body = bull ? close[j] - open[j] : open[j] - close[j]
                    if body >= obBody * a
                        disp := true
                    if j <= obk - 2 and (bull ? low[j] > high[j + 2] : high[j] < low[j + 2])
                        fvg := true
                    vsum := vsum + nz(volume[j])
                bool sweepOk = not obSweep
                if obSweep and lqP.size() > 0
                    float ext = bull ? low[obk] : high[obk]
                    for i = 0 to lqP.size() - 1
                        if lqI.get(i) < bar_index - obk and (bull ? ext < lqP.get(i) : ext > lqP.get(i))
                            sweepOk := true
                bool volOk_   = not obVol or vsum / obk > va * volMult
                bool trendOk_ = not obTrend or (bull ? close > e : close < e)
                if imp >= obDisp * a and disp and (fvg or not obFvg) and volOk_ and trendOk_ and sweepOk
                    bool overlap = false
                    if oT.size() > 0
                        for i = 0 to oT.size() - 1
                            if top >= oBtm.get(i) and btm <= oTop.get(i)
                                overlap := true
                    if not overlap
                        oT.push(time[obk])
                        oTop.push(top)
                        oBtm.push(btm)
                        oTap.push(false)
                        if oT.size() > 2
                            oT.shift()
                            oTop.shift()
                            oBtm.shift()
                            oTap.shift()
    int   n   = oT.size()
    int   t1  = na
    float tp1 = na
    float bt1 = na
    bool  tk1 = false
    int   t2  = na
    float tp2 = na
    float bt2 = na
    bool  tk2 = false
    if n >= 1
        t1  := oT.get(n - 1)
        tp1 := oTop.get(n - 1)
        bt1 := oBtm.get(n - 1)
        tk1 := oTap.get(n - 1)
    if n >= 2
        t2  := oT.get(n - 2)
        tp2 := oTop.get(n - 2)
        bt2 := oBtm.get(n - 2)
        tk2 := oTap.get(n - 2)
    [t1[off], tp1[off], bt1[off], tk1[off], t2[off], tp2[off], bt2[off], tk2[off]]

[u1t1, u1p1, u1b1, u1k1, u1t2, u1p2, u1b2, u1k2] = request.security(syminfo.tickerid, obH1Tf, f_htfOB(obH_Piv, true, iH))
[d1t1, d1p1, d1b1, d1k1, d1t2, d1p2, d1b2, d1k2] = request.security(syminfo.tickerid, obH1Tf, f_htfOB(obH_Piv, false, iH))
[u2t1, u2p1, u2b1, u2k1, u2t2, u2p2, u2b2, u2k2] = request.security(syminfo.tickerid, obH2Tf, f_htfOB(obH_Piv, true, iH))
[d2t1, d2p1, d2b1, d2k1, d2t2, d2p2, d2b2, d2k2] = request.security(syminfo.tickerid, obH2Tf, f_htfOB(obH_Piv, false, iH))

bool obH1Ok = obOn and obH1On and chartSec < timeframe.in_seconds(obH1Tf)
bool obH2Ok = obOn and obH2On and chartSec < timeframe.in_seconds(obH2Tf)

var array<box>  htfBoxes = array.new<box>()
var array<line> htfMids  = array.new<line>()

f_htfBox(int t, float top, float btm, bool tapped, bool bull, string tag) =>
    if not na(t)
        color c  = bull ? obBullCol : obBearCol
        box   bx = box.new(t, top, time, btm, xloc = xloc.bar_time, extend = extend.right, border_color = c, border_width = 2, border_style = tapped ? line.style_dashed : line.style_solid, bgcolor = color.new(c, tapped ? 90 : 75), text = tag + (bull ? " Bull OB" : " Bear OB"), text_color = c, text_size = size.small, text_halign = text.align_left, text_valign = text.align_center)
        htfBoxes.push(bx)
        if obMid
            htfMids.push(line.new(t, (top + btm) / 2, time, (top + btm) / 2, xloc = xloc.bar_time, extend = extend.right, color = c, style = line.style_dashed))

if barstate.islast
    for b in htfBoxes
        b.delete()
    for l in htfMids
        l.delete()
    htfBoxes.clear()
    htfMids.clear()
    if obH1Ok
        string n1 = f_tfName(obH1Tf)
        f_htfBox(u1t1, u1p1, u1b1, u1k1, true, n1)
        f_htfBox(u1t2, u1p2, u1b2, u1k2, true, n1)
        f_htfBox(d1t1, d1p1, d1b1, d1k1, false, n1)
        f_htfBox(d1t2, d1p2, d1b2, d1k2, false, n1)
    if obH2Ok
        string n2 = f_tfName(obH2Tf)
        f_htfBox(u2t1, u2p1, u2b1, u2k1, true, n2)
        f_htfBox(u2t2, u2p2, u2b2, u2k2, true, n2)
        f_htfBox(d2t1, d2p1, d2b1, d2k1, false, n2)
        f_htfBox(d2t2, d2p2, d2b2, d2k2, false, n2)

// First tap of an HTF zone, seen on the chart's own candles (earlier than
// waiting for the HTF candle to close). Each zone fires once.
var array<int> tapU1 = array.new<int>()
var array<int> tapD1 = array.new<int>()
var array<int> tapU2 = array.new<int>()
var array<int> tapD2 = array.new<int>()

f_tap(int t, float top, float btm, bool tk, bool bull, array<int> done) =>
    bool hit = false
    if not na(t) and not tk and not done.includes(t) and (bull ? low <= top : high >= btm)
        hit := true
        done.push(t)
        if done.size() > 10
            done.shift()
    hit

bool hU1 = obH1Ok and (f_tap(u1t1, u1p1, u1b1, u1k1, true, tapU1) or f_tap(u1t2, u1p2, u1b2, u1k2, true, tapU1))
bool hD1 = obH1Ok and (f_tap(d1t1, d1p1, d1b1, d1k1, false, tapD1) or f_tap(d1t2, d1p2, d1b2, d1k2, false, tapD1))
bool hU2 = obH2Ok and (f_tap(u2t1, u2p1, u2b1, u2k1, true, tapU2) or f_tap(u2t2, u2p2, u2b2, u2k2, true, tapU2))
bool hD2 = obH2Ok and (f_tap(d2t1, d2p1, d2b1, d2k1, false, tapD2) or f_tap(d2t2, d2p2, d2b2, d2k2, false, tapD2))
bool htfObBullTap = hU1 or hU2
bool htfObBearTap = hD1 or hD2

// ─── Previous period H / L / C (multi-timeframe) ─────────────────────────────
// "1D" → "PD", "1W" → "PW", "1M" → "PM", "240" → "4H "
f_prefix(string tf) =>
    string n = f_tfName(tf)
    n == "D" or n == "W" or n == "M" ? "P" + n : n + " "

bool chg1     = timeframe.change(pp1Tf)
bool chg2     = timeframe.change(pp2Tf)
bool chg3     = timeframe.change(pp3Tf)

var Period per1 = Period.new(f_prefix(pp1Tf), pp1Col, pp1On and chartSec < timeframe.in_seconds(pp1Tf))
var Period per2 = Period.new(f_prefix(pp2Tf), pp2Col, pp2On and chartSec < timeframe.in_seconds(pp2Tf))
var Period per3 = Period.new(f_prefix(pp3Tf), pp3Col, pp3On and chartSec < timeframe.in_seconds(pp3Tf))
per1.track(chg1)
per2.track(chg2)
per3.track(chg3)

// The current levels are redrawn on the last bar only, so they are always the
// newest drawings on the chart. Past periods, when wanted, are plots.
var array<line>  ppLines = array.new<line>()
var array<label> ppLbls  = array.new<label>()
string           ppStyle = ppStyleIn == "Solid" ? line.style_solid : ppStyleIn == "Dotted" ? line.style_dotted : line.style_dashed

f_level(int x1, int x2, float y, color c, string txt, string st) =>
    ppLines.push(line.new(x1, y, x2, y, color = c, style = st, width = 1))
    if ppLabels
        ppLbls.push(label.new(x2, y, txt + " " + str.tostring(y, format.mintick), style = label.style_label_left, color = color(na), textcolor = c, size = size.small))

f_draw(Period p, int x2) =>
    if p.enabled and not na(p.pH)
        f_level(p.pHBar, x2, p.pH, p.col, p.pfx + "H", ppStyle)
        f_level(p.pLBar, x2, p.pL, p.col, p.pfx + "L", ppStyle)
        if ppClose
            f_level(p.pCBar, x2, p.pC, color.new(p.col, 40), p.pfx + "C", line.style_dotted)

if barstate.islast
    for l in ppLines
        l.delete()
    for lb in ppLbls
        lb.delete()
    ppLines.clear()
    ppLbls.clear()
    int x2 = bar_index + 10
    f_draw(per1, x2)
    f_draw(per2, x2)
    f_draw(per3, x2)

bool past1 = per1.enabled and ppHist and not chg1
bool past2 = per2.enabled and ppHist and not chg2
bool past3 = per3.enabled and ppHist and not chg3
plot(past1 ? per1.pH : na, "Period 1 high", pp1Col, 1, plot.style_linebr)
plot(past1 ? per1.pL : na, "Period 1 low", pp1Col, 1, plot.style_linebr)
plot(past2 ? per2.pH : na, "Period 2 high", pp2Col, 1, plot.style_linebr)
plot(past2 ? per2.pL : na, "Period 2 low", pp2Col, 1, plot.style_linebr)
plot(past3 ? per3.pH : na, "Period 3 high", pp3Col, 1, plot.style_linebr)
plot(past3 ? per3.pL : na, "Period 3 low", pp3Col, 1, plot.style_linebr)

f_up(Period p) =>
    p.enabled and close > p.pH and close[1] <= p.pH
f_dn(Period p) =>
    p.enabled and close < p.pL and close[1] >= p.pL
f_alerts(Period p, bool up, bool dn) =>
    if up
        alert(syminfo.ticker + ": close above " + p.pfx + "H", alert.freq_once_per_bar_close)
    if dn
        alert(syminfo.ticker + ": close below " + p.pfx + "L", alert.freq_once_per_bar_close)

bool up1  = f_up(per1)
bool up2  = f_up(per2)
bool up3  = f_up(per3)
bool dn1  = f_dn(per1)
bool dn2  = f_dn(per2)
bool dn3  = f_dn(per3)
bool ppUp = up1 or up2 or up3
bool ppDn = dn1 or dn2 or dn3
f_alerts(per1, up1, dn1)
f_alerts(per2, up2, dn2)
f_alerts(per3, up3, dn3)

// ─── Signals ─────────────────────────────────────────────────────────────────
plotshape(showSig and resBO, "Bullish breakout", shape.labelup, location.belowbar, colSup, text = "BO", textcolor = color.white, size = size.small)
plotshape(showSig and supBD, "Bearish breakdown", shape.labeldown, location.abovebar, colRes, text = "BD", textcolor = color.white, size = size.small)
plotshape(showSig and htfBO, "HTF bullish breakout", shape.labelup, location.belowbar, colSup, text = "HTF BO", textcolor = color.white, size = size.normal)
plotshape(showSig and htfBD, "HTF bearish breakdown", shape.labeldown, location.abovebar, colRes, text = "HTF BD", textcolor = color.white, size = size.normal)
plotshape(showRetest and resRT, "Bullish retest", shape.triangleup, location.belowbar, colSup, text = "RT", textcolor = colSup, size = size.tiny)
plotshape(showRetest and supRT, "Bearish retest", shape.triangledown, location.abovebar, colRes, text = "RT", textcolor = colRes, size = size.tiny)
plotshape(obOn and obBullTap, "Bullish OB tap", shape.diamond, location.belowbar, obBullCol, text = "OB", textcolor = obBullCol, size = size.tiny)
plotshape(obOn and obBearTap, "Bearish OB tap", shape.diamond, location.abovebar, obBearCol, text = "OB", textcolor = obBearCol, size = size.tiny)
plotshape(htfObBullTap, "HTF bullish OB tap", shape.diamond, location.belowbar, obBullCol, text = "HTF OB", textcolor = obBullCol, size = size.small)
plotshape(htfObBearTap, "HTF bearish OB tap", shape.diamond, location.abovebar, obBearCol, text = "HTF OB", textcolor = obBearCol, size = size.small)

alertcondition(resBO, "Bullish trendline breakout", "{{ticker}}: close above a resistance trendline")
alertcondition(supBD, "Bearish trendline breakdown", "{{ticker}}: close below a support trendline")
alertcondition(ppUp, "Close above previous period high", "{{ticker}}: close above a previous period high")
alertcondition(ppDn, "Close below previous period low", "{{ticker}}: close below a previous period low")
alertcondition(resRT, "Bullish retest", "{{ticker}}: retest of a broken resistance trendline")
alertcondition(supRT, "Bearish retest", "{{ticker}}: retest of a broken support trendline")
alertcondition(htfBO, "HTF bullish trendline breakout", "{{ticker}}: higher-timeframe resistance trendline broken")
alertcondition(htfBD, "HTF bearish trendline breakdown", "{{ticker}}: higher-timeframe support trendline broken")
alertcondition(obBullNew, "New bullish order block", "{{ticker}}: new bullish order block")
alertcondition(obBearNew, "New bearish order block", "{{ticker}}: new bearish order block")
alertcondition(obBullTap, "Bullish order block tapped", "{{ticker}}: price tapped a bullish order block")
alertcondition(obBearTap, "Bearish order block tapped", "{{ticker}}: price tapped a bearish order block")
alertcondition(htfObBullTap, "HTF bullish order block tapped", "{{ticker}}: price tapped a higher-timeframe bullish order block")
alertcondition(htfObBearTap, "HTF bearish order block tapped", "{{ticker}}: price tapped a higher-timeframe bearish order block")

if resBO
    alert(syminfo.ticker + ": breakout above resistance trendline", alert.freq_once_per_bar_close)
if supBD
    alert(syminfo.ticker + ": breakdown below support trendline", alert.freq_once_per_bar_close)
if resRT and showRetest
    alert(syminfo.ticker + ": bullish retest of broken trendline", alert.freq_once_per_bar_close)
if supRT and showRetest
    alert(syminfo.ticker + ": bearish retest of broken trendline", alert.freq_once_per_bar_close)
if htfBO
    alert(syminfo.ticker + ": higher-timeframe resistance trendline broken", alert.freq_once_per_bar_close)
if htfBD
    alert(syminfo.ticker + ": higher-timeframe support trendline broken", alert.freq_once_per_bar_close)
if obOn and obBullTap
    alert(syminfo.ticker + ": price tapped a bullish order block", alert.freq_once_per_bar_close)
if obOn and obBearTap
    alert(syminfo.ticker + ": price tapped a bearish order block", alert.freq_once_per_bar_close)
if htfObBullTap
    alert(syminfo.ticker + ": price tapped a higher-timeframe bullish order block", alert.freq_once_per_bar_close)
if htfObBearTap
    alert(syminfo.ticker + ": price tapped a higher-timeframe bearish order block", alert.freq_once_per_bar_close)
