{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vitaqueen-coming-soon",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "observability": {
    "enabled": true
  }

  // این فایل فقط برای deploy از طریق CLI لازم است.
  // اگر کد را مستقیم در داشبورد کلادفلر paste می‌کنید، به آن نیازی ندارید.
  //
  // تنظیمات صفحه در بالای worker.js داخل CONFIG است.
  //
  // برای وصل‌کردن دامنه بعد از اولین deploy، این بخش را از کامنت خارج کنید:
  // "routes": [
  //   { "pattern": "example.com", "custom_domain": true },
  //   { "pattern": "www.example.com", "custom_domain": true }
  // ]
}
