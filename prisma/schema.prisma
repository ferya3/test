// EscrowBridge — escrow platform for digital goods paid in USDT.
//
// Money is stored as integer "micro-USDT" (6 decimals, matching the USDT
// contract) so no float rounding can ever creep into a balance.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  displayName  String
  role         String  @default("USER") // USER | ADMIN
  payoutAddress String? // the user's own USDT address for withdrawals
  payoutNetwork String  @default("TRON")
  isBlocked    Boolean @default(false)

  /// Spendable balance in micro-USDT. Only ever written together with a
  /// LedgerEntry, inside one transaction — see src/lib/ledger.ts.
  balanceMicro BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings       Listing[]
  buyerDeals     Deal[]        @relation("BuyerDeals")
  sellerDeals    Deal[]        @relation("SellerDeals")
  messages       Message[]
  disputes       Dispute[]     @relation("DisputeOpener")
  auditLogs      AuditLog[]
  sessions       Session[]
  resetTokens    PasswordResetToken[]
  ledgerEntries  LedgerEntry[] @relation("LedgerOwner")
  ledgerActions  LedgerEntry[] @relation("LedgerActor")
  withdrawals    Withdrawal[]  @relation("WithdrawalOwner")
  reviewedWithdrawals Withdrawal[] @relation("WithdrawalReviewer")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Listing {
  id          String  @id @default(cuid())
  sellerId    String
  seller      User    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title       String
  category    String  @default("OTHER") // GAMING | SOCIAL | SOFTWARE | SUBSCRIPTION | DOMAIN | OTHER
  description String
  priceMicro  BigInt // asking price in micro-USDT
  status      String  @default("ACTIVE") // ACTIVE | PAUSED | SOLD | REMOVED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals Deal[]

  @@index([status, createdAt])
  @@index([sellerId])
}

/// A single escrow transaction between one buyer and one seller.
model Deal {
  id        String  @id @default(cuid())
  reference String  @unique // human-friendly code shown in the UI, e.g. EB-7QK2M9

  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  buyerId  String
  buyer    User   @relation("BuyerDeals", fields: [buyerId], references: [id])
  sellerId String
  seller   User   @relation("SellerDeals", fields: [sellerId], references: [id])

  title       String
  description String

  // AWAITING_PAYMENT -> FUNDED -> DELIVERED -> COMPLETED
  //                            \-> DISPUTED -> COMPLETED | REFUNDED
  //                  \-> CANCELLED | EXPIRED
  status String @default("AWAITING_PAYMENT")

  amountMicro   BigInt // what the buyer funds: payoutMicro + feeMicro
  feeMicro      BigInt // platform fee, charged on top of the sale price
  payoutMicro   BigInt // the sale price, which is what the seller receives
  network       String @default("TRON") // TRON (TRC-20) | BSC (BEP-20) | ETHEREUM (ERC-20)

  /// Set only when a watch-only xpub is configured. With a shared treasury
  /// address instead, there is nothing per-deal to derive and both are null.
  depositAddress    String? @unique
  depositDerivation Int?    @unique // HD index used to derive depositAddress
  inspectionHours   Int     @default(48)

  fundedAt      DateTime?
  deliveredAt   DateTime?
  inspectionEndsAt DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  refundedAt    DateTime?
  expiresAt     DateTime // payment window; deal auto-expires if never funded

  buyerRefundAddress String?
  /// FUNDED_ON_CHAIN when the buyer sent USDT to the deposit address,
  /// FUNDED_FROM_BALANCE when it came out of their platform balance.
  fundingSource      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credentials  Credential[]
  payments     Payment[]
  messages     Message[]
  dispute      Dispute?
  ledgerEntries LedgerEntry[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status])
}

/// A secret handed over by the seller (login, password, recovery code, note).
/// `ciphertext` is AES-256-GCM; the plaintext never touches the database.
model Credential {
  id        String @id @default(cuid())
  dealId    String
  deal      Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  label     String
  kind      String @default("SECRET") // USERNAME | PASSWORD | EMAIL | RECOVERY | SECRET | NOTE
  /// Secret material is stored only in this envelope: iv:tag:ciphertext (base64).
  ciphertext String
  /// Set once the buyer has actually read the value, for the audit trail.
  firstRevealedAt DateTime?
  revealCount     Int      @default(0)
  purgedAt        DateTime?

  /// The buyer ticks each item off as they verify it works. A deal is only
  /// safe to release once every item is confirmed.
  confirmedAt   DateTime?
  /// Set when the buyer marks an item as *not* working, with their reason.
  rejectedAt    DateTime?
  rejectedNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
}

/// An on-chain USDT transfer observed on a deal's deposit address.
model Payment {
  id            String @id @default(cuid())
  dealId        String
  deal          Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  txHash        String @unique
  fromAddress   String?
  amountMicro   BigInt
  network       String
  confirmations Int    @default(0)
  status        String @default("PENDING") // PENDING | CONFIRMED | UNDERPAID | OVERPAID
  seenAt        DateTime @default(now())
  confirmedAt   DateTime?

  @@index([dealId])
}

/// Append-only record of every movement on a user's balance. The sum of a
/// user's entries must always equal User.balanceMicro — the treasury page
/// reconciles the two and flags any drift.
model LedgerEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("LedgerOwner", fields: [userId], references: [id], onDelete: Cascade)

  /// Signed: positive credits the user, negative debits them.
  amountMicro      BigInt
  /// The user's balance immediately after this entry was applied.
  balanceAfterMicro BigInt

  // MANUAL_CREDIT | MANUAL_DEBIT | DEAL_FUNDING | DEAL_PAYOUT | DEAL_REFUND
  // | WITHDRAWAL | WITHDRAWAL_REVERSAL
  kind String

  /// Free-text reason. Required for anything an admin does by hand.
  note String?
  /// On-chain hash, deal id or withdrawal id this entry relates to.
  reference String?

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  /// The admin who made this happen, when it was not the user themselves.
  actorId String?
  actor   User?   @relation("LedgerActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([kind])
}

/// A user's request to move their balance out to their own USDT address. The
/// treasury operator broadcasts the transfer and records the hash here.
model Withdrawal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("WithdrawalOwner", fields: [userId], references: [id], onDelete: Cascade)

  amountMicro BigInt
  toAddress   String
  network     String
  // REQUESTED -> APPROVED -> SENT, or REQUESTED -> REJECTED
  status String @default("REQUESTED")
  txHash String?
  note   String?

  reviewedById String?
  reviewedBy   User?   @relation("WithdrawalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now())
  reviewedAt DateTime?
  sentAt     DateTime?

  @@index([status, createdAt])
  @@index([userId])
}

model Message {
  id       String @id @default(cuid())
  dealId   String
  deal     Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body     String
  isStaff  Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([dealId, createdAt])
}

model Dispute {
  id         String @id @default(cuid())
  dealId     String @unique
  deal       Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  openedById String
  openedBy   User   @relation("DisputeOpener", fields: [openedById], references: [id])
  reason     String
  status     String @default("OPEN") // OPEN | RESOLVED_BUYER | RESOLVED_SELLER
  resolution String?
  createdAt  DateTime @default(now())
  resolvedAt DateTime?
}

/// Append-only trail of every state change that touches money or secrets.
model AuditLog {
  id       String  @id @default(cuid())
  actorId  String?
  actor    User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action   String
  entity   String
  entityId String
  metadata String? // JSON
  ip       String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/// A single-use link that lets someone who has lost their password set a new
/// one. Only the hash is stored, so a database dump cannot be used to reset
/// anybody's account.
model PasswordResetToken {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// The platform's own receiving address for one network. Buyers send here when
/// no watch-only xpub is configured, so the operator can run the platform from
/// an ordinary wallet and credit deposits by hand.
model TreasuryWallet {
  id      String @id @default(cuid())
  network String @unique // TRON | BSC | ETHEREUM
  address String
  /// Free-text note shown to buyers, e.g. which exchange it is held at.
  note    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Single-row table holding operator-tunable settings.
model Settings {
  id                String @id @default("singleton")
  feeBasisPoints    Int    @default(500) // 5.00%, charged on top of the sale price
  minDealMicro      BigInt @default(5000000)   // 5 USDT
  maxDealMicro      BigInt @default(50000000000) // 50,000 USDT
  minWithdrawalMicro BigInt @default(10000000)  // 10 USDT
  paymentWindowMins Int    @default(120)
  requiredConfirmations Int @default(20)
  nextDerivationIndex   Int @default(1)

  /// Added to the real figures on the landing page. Operators use these to
  /// carry over history from before the platform, or to set a launch baseline.
  /// They are shown to visitors, so keep them defensible.
  showcaseUsers Int @default(4000)
  showcaseDeals Int @default(1800)
  updatedAt DateTime @updatedAt @default(now())
}
