//@version=6
// Gold Scalper Pro — XAUUSD signal indicator for the 1m and 5m charts.
// Trend-following pullback entries, filtered by higher-timeframe bias,
// momentum, volatility and trading session. Markers are drawn under the
// candles, with ATR-based stop loss and take profit levels.
indicator("Gold Scalper Pro — XAUUSD M1/M5", shorttitle="GoldScalper", overlay=true, max_labels_count=500, max_lines_count=500)

// ─────────────────────────── inputs ───────────────────────────
gTrend = "Trend"
fastLen  = input.int(21,  "Fast EMA (pullback)", minval=2,  group=gTrend)
slowLen  = input.int(50,  "Slow EMA",            minval=3,  group=gTrend)
trendLen = input.int(200, "Trend EMA",           minval=10, group=gTrend)
useHtf   = input.bool(true,  "Use higher timeframe bias", group=gTrend)
htfTf    = input.timeframe("15", "Higher timeframe",      group=gTrend)
htfLen   = input.int(50, "Higher timeframe EMA", minval=3, group=gTrend)

gEntry = "Entry"
pullbackBars = input.int(6,  "Pullback must happen within N bars", minval=1, maxval=30, group=gEntry)
rsiLen       = input.int(14, "RSI length",   minval=2, group=gEntry)
rsiBuyMin    = input.float(50.0, "RSI floor for buys",   minval=1, maxval=99, step=0.5, group=gEntry)
rsiSellMax   = input.float(50.0, "RSI ceiling for sells", minval=1, maxval=99, step=0.5, group=gEntry)
rsiExhaust   = input.float(78.0, "Block entries beyond RSI extreme", minval=55, maxval=99, step=0.5, group=gEntry, tooltip="Buys are skipped above this value, sells below (100 - value).")
needMacd     = input.bool(true, "Require MACD histogram to agree", group=gEntry)
cooldownBars = input.int(8, "Cooldown between signals (bars)", minval=0, maxval=100, group=gEntry)

gFilter = "Filters"
adxLen    = input.int(14, "ADX length", minval=2, group=gFilter)
adxMin    = input.float(20.0, "Minimum ADX (skip chop)", minval=0, maxval=60, step=0.5, group=gFilter)
atrLen    = input.int(14, "ATR length", minval=2, group=gFilter)
minAtrPct = input.float(0.02, "Minimum ATR as % of price", minval=0.0, maxval=1.0, step=0.01, group=gFilter, tooltip="Filters out dead, illiquid candles. 0.02 suits XAUUSD on M1/M5.")
useSession   = input.bool(true, "Trade only inside session", group=gFilter)
sessionStr   = input.session("0700-2000", "Session (London + New York)", group=gFilter)
sessionTz    = input.string("UTC", "Session timezone", options=["UTC", "Europe/London", "America/New_York", "Asia/Tehran", "Asia/Dubai"], group=gFilter)
skipOpenBars = input.int(2, "Skip first N bars of the session", minval=0, maxval=30, group=gFilter)

gRisk = "Risk"
slAtrMult = input.float(1.5, "Stop loss (× ATR)",   minval=0.2, step=0.1, group=gRisk)
rMultiple = input.float(2.0, "Take profit (R multiple)", minval=0.5, step=0.1, group=gRisk)
showLevels = input.bool(true, "Draw SL / TP levels", group=gRisk)

gStyle = "Appearance"
sellBelow  = input.bool(true, "Draw sell markers below the candle too", group=gStyle)
showText   = input.bool(true, "Write BUY / SELL on the marker",         group=gStyle)
showEmas   = input.bool(true, "Show the EMAs",                          group=gStyle)
showPanel  = input.bool(true, "Show the info panel",                    group=gStyle)
buyColor   = input.color(color.new(#00a86b, 0), "Buy colour",  group=gStyle)
sellColor  = input.color(color.new(#e5333f, 0), "Sell colour", group=gStyle)

// ─────────────────────────── indicators ───────────────────────────
emaFast  = ta.ema(close, fastLen)
emaSlow  = ta.ema(close, slowLen)
emaTrend = ta.ema(close, trendLen)

// One bar back on the higher timeframe, so a closed value is used and the
// signal never repaints as the higher-timeframe candle forms.
htfEma = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfLen)[1], lookahead=barmerge.lookahead_off)

rsi = ta.rsi(close, rsiLen)
[_macdLine, _signalLine, hist] = ta.macd(close, 12, 26, 9)

[_diPlus, _diMinus, adx] = ta.dmi(adxLen, adxLen)
atr = ta.atr(atrLen)
atrPct = atr / close * 100.0

inSession = not useSession or not na(time(timeframe.period, sessionStr, sessionTz))
sessionStarted = inSession and not inSession[1]
barsIntoSession = ta.barssince(sessionStarted)
sessionReady = inSession and (na(barsIntoSession) or barsIntoSession >= skipOpenBars)

volatileEnough = atrPct >= minAtrPct
trending = adx >= adxMin

// ─────────────────────────── bias ───────────────────────────
htfBull = not useHtf or close > htfEma
htfBear = not useHtf or close < htfEma

bullBias = close > emaTrend and emaFast > emaSlow and htfBull
bearBias = close < emaTrend and emaFast < emaSlow and htfBear

// A pullback is a recent tag of the fast EMA in the direction of the trend.
pulledBackLong  = ta.barssince(low  <= emaFast) <= pullbackBars
pulledBackShort = ta.barssince(high >= emaFast) <= pullbackBars

// ─────────────────────────── triggers ───────────────────────────
macdBull = not needMacd or (hist > 0 and hist > hist[1])
macdBear = not needMacd or (hist < 0 and hist < hist[1])

rawBuy = bullBias and pulledBackLong and close > emaFast and close > open and rsi >= rsiBuyMin and rsi < rsiExhaust and macdBull
rawSell = bearBias and pulledBackShort and close < emaFast and close < open and rsi <= rsiSellMax and rsi > (100.0 - rsiExhaust) and macdBear

tradeable = sessionReady and volatileEnough and trending
candBuy  = rawBuy  and tradeable
candSell = rawSell and tradeable

// Only one signal per direction per swing, plus a cooldown in bars.
var int lastDir = 0
var int lastBar = na
cooledDown = na(lastBar) or (bar_index - lastBar) >= cooldownBars

buySignal  = candBuy  and cooledDown and lastDir !=  1
sellSignal = candSell and cooledDown and lastDir != -1

if buySignal
    lastDir := 1
    lastBar := bar_index
if sellSignal
    lastDir := -1
    lastBar := bar_index

// The bias flipping resets the "one per swing" lock.
if lastDir == 1 and bearBias
    lastDir := 0
if lastDir == -1 and bullBias
    lastDir := 0

// ─────────────────────────── risk levels ───────────────────────────
var float entryPx = na
var float slPx    = na
var float tpPx    = na
var int   openDir = 0
var int   wins    = 0
var int   losses  = 0

if buySignal
    entryPx := close
    slPx    := close - atr * slAtrMult
    tpPx    := close + atr * slAtrMult * rMultiple
    openDir := 1
else if sellSignal
    entryPx := close
    slPx    := close + atr * slAtrMult
    tpPx    := close - atr * slAtrMult * rMultiple
    openDir := -1

// Resolve the previous signal on later bars. The stop is checked first, so a
// bar that spans both levels counts as a loss rather than a win.
newSignal = buySignal or sellSignal
if openDir == 1 and not newSignal
    if low <= slPx
        losses := losses + 1
        openDir := 0
    else if high >= tpPx
        wins := wins + 1
        openDir := 0
else if openDir == -1 and not newSignal
    if high >= slPx
        losses := losses + 1
        openDir := 0
    else if low <= tpPx
        wins := wins + 1
        openDir := 0

if showLevels and newSignal
    lineColor = buySignal ? buyColor : sellColor
    line.new(bar_index, entryPx, bar_index + 20, entryPx, color=color.new(lineColor, 40), style=line.style_dotted, width=1)
    line.new(bar_index, slPx, bar_index + 20, slPx, color=color.new(sellColor, 30), style=line.style_dashed, width=1)
    line.new(bar_index, tpPx, bar_index + 20, tpPx, color=color.new(buyColor, 30), style=line.style_dashed, width=1)
    label.new(bar_index + 20, slPx, "SL " + str.tostring(slPx, format.mintick), style=label.style_label_left, color=color.new(sellColor, 80), textcolor=sellColor, size=size.tiny)
    label.new(bar_index + 20, tpPx, "TP " + str.tostring(tpPx, format.mintick), style=label.style_label_left, color=color.new(buyColor, 80), textcolor=buyColor, size=size.tiny)

// ─────────────────────────── drawing ───────────────────────────
plot(showEmas ? emaFast  : na, "EMA fast",  color=color.new(color.orange, 20), linewidth=1)
plot(showEmas ? emaSlow  : na, "EMA slow",  color=color.new(color.blue, 20),   linewidth=1)
plot(showEmas ? emaTrend : na, "EMA trend", color=color.new(color.gray, 10),   linewidth=2)

plotshape(buySignal and showText, "BUY", shape.triangleup, location.belowbar, buyColor, text="BUY", textcolor=buyColor, size=size.small)
plotshape(buySignal and not showText, "BUY (no text)", shape.triangleup, location.belowbar, buyColor, size=size.small)
plotshape(sellSignal and sellBelow and showText, "SELL (below)", shape.triangledown, location.belowbar, sellColor, text="SELL", textcolor=sellColor, size=size.small)
plotshape(sellSignal and sellBelow and not showText, "SELL (below, no text)", shape.triangledown, location.belowbar, sellColor, size=size.small)
plotshape(sellSignal and not sellBelow and showText, "SELL (above)", shape.triangledown, location.abovebar, sellColor, text="SELL", textcolor=sellColor, size=size.small)
plotshape(sellSignal and not sellBelow and not showText, "SELL (above, no text)", shape.triangledown, location.abovebar, sellColor, size=size.small)

barcolor(buySignal ? buyColor : sellSignal ? sellColor : na)

// ─────────────────────────── info panel ───────────────────────────
var table t = table.new(position.top_right, 2, 6, border_width=1, frame_color=color.new(color.gray, 60), frame_width=1)

if showPanel and barstate.islast
    total = wins + losses
    winRate = total > 0 ? 100.0 * wins / total : 0.0
    biasText = bullBias ? "Bullish" : bearBias ? "Bearish" : "Neutral"
    biasColor = bullBias ? buyColor : bearBias ? sellColor : color.gray
    table.cell(t, 0, 0, "GoldScalper", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small)
    table.cell(t, 1, 0, timeframe.period, text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small)
    table.cell(t, 0, 1, "Bias", text_size=size.tiny)
    table.cell(t, 1, 1, biasText, text_color=biasColor, text_size=size.tiny)
    table.cell(t, 0, 2, "ADX", text_size=size.tiny)
    table.cell(t, 1, 2, str.tostring(adx, "#.0") + (trending ? " ✓" : " ✕"), text_color=trending ? buyColor : color.gray, text_size=size.tiny)
    table.cell(t, 0, 3, "ATR %", text_size=size.tiny)
    table.cell(t, 1, 3, str.tostring(atrPct, "#.###") + (volatileEnough ? " ✓" : " ✕"), text_color=volatileEnough ? buyColor : color.gray, text_size=size.tiny)
    table.cell(t, 0, 4, "Session", text_size=size.tiny)
    table.cell(t, 1, 4, sessionReady ? "open" : "closed", text_color=sessionReady ? buyColor : color.gray, text_size=size.tiny)
    table.cell(t, 0, 5, "TP / SL hit", text_size=size.tiny)
    table.cell(t, 1, 5, str.tostring(wins) + " / " + str.tostring(losses) + "  (" + str.tostring(winRate, "#.0") + "%)", text_size=size.tiny)

// ─────────────────────────── alerts ───────────────────────────
alertcondition(buySignal,  "Gold BUY",  "GoldScalper BUY {{ticker}} {{interval}} @ {{close}}")
alertcondition(sellSignal, "Gold SELL", "GoldScalper SELL {{ticker}} {{interval}} @ {{close}}")
alertcondition(buySignal or sellSignal, "Gold BUY or SELL", "GoldScalper signal on {{ticker}} {{interval}} @ {{close}}")

if buySignal
    alert("BUY " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + " | SL " + str.tostring(slPx, format.mintick) + " | TP " + str.tostring(tpPx, format.mintick), alert.freq_once_per_bar_close)
if sellSignal
    alert("SELL " + syminfo.ticker + " @ " + str.tostring(close, format.mintick) + " | SL " + str.tostring(slPx, format.mintick) + " | TP " + str.tostring(tpPx, format.mintick), alert.freq_once_per_bar_close)
