{
  "manifest_version": 3,
  "name": "Gmail Subject Cleaner",
  "version": "2.0.0",
  "description": "جستجوی ایمیل‌های جیمیل بر اساس عنوان و حذف دسته‌جمعی آن‌ها — بدون نیاز به تنظیمات",
  "permissions": ["scripting"],
  "host_permissions": ["https://mail.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Gmail Subject Cleaner"
  }
}
