{
  "manifest_version": 3,
  "name": "Gmail Subject Cleaner",
  "version": "1.0.0",
  "description": "جستجوی ایمیل‌های جیمیل بر اساس عنوان و حذف دسته‌جمعی آن‌ها",
  "key": "",
  "permissions": ["identity"],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://mail.google.com/"]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gmail Subject Cleaner"
  }
}
