# docker compose reads this file (copy to .env).

# Claude for the vision / reasoning / coding / qa roles. Leave empty for the
# offline computer-vision mode (layout, colours and behaviours are measured;
# texts and fonts are placeholders).
ANTHROPIC_API_KEY=

# Signs access, preview and media tokens. Use 32+ random characters.
RECODE_SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-chars

# Optional model / effort overrides per role
# RECODE_MODEL_VISION=claude-opus-5-5
# RECODE_MODEL_CODING=claude-opus-5-5
# RECODE_EFFORT_CODING=high
# RECODE_QA_THRESHOLD=88
# RECODE_MAX_FIX_ITERATIONS=3

HTTP_PORT=80
POSTGRES_PASSWORD=recode
MINIO_ROOT_USER=recode
MINIO_ROOT_PASSWORD=recode-secret

# Worker processes per queue (defaults fit a 4 GB server; raise them on bigger machines)
# API_WORKERS=2
# VIDEO_CONCURRENCY=1
# AI_CONCURRENCY=2
# CODE_CONCURRENCY=1
# TEST_CONCURRENCY=1

# React (Vite) projects are built in throw-away containers through the host's
# Docker socket. Set SANDBOX_MODE=none to disable builds (HTML projects still work).
SANDBOX_MODE=docker
# group id of /var/run/docker.sock on the host:  stat -c %g /var/run/docker.sock
DOCKER_GID=999
