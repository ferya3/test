# Copy to .env for local development (uvicorn reads it from this folder).
RECODE_ENV=development
RECODE_SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-chars
RECODE_DATABASE_URL=sqlite:///./data/recode.db
RECODE_STORAGE_ROOT=./data/storage
RECODE_TASK_MODE=inline
RECODE_CORS_ORIGINS=["http://localhost:3000"]
RECODE_PUBLIC_API_URL=http://localhost:8000

# AI: "anthropic" uses Claude for vision / reasoning / coding / qa.
# Without credentials the platform falls back to the offline computer-vision mode.
RECODE_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# RECODE_MODEL_VISION=claude-opus-5-5
# RECODE_MODEL_REASONING=claude-opus-5-5
# RECODE_MODEL_CODING=claude-opus-5-5
# RECODE_MODEL_QA=claude-opus-5-5

# Only needed if Playwright's bundled Chromium is not installed:
# RECODE_CHROMIUM_PATH=/path/to/chromium
